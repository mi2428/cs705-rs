from enum import Enum
from typing import ClassVar
from .diagnostic import Diagnostic
from . import Error as Error
from .icf import Agc, FilterShape, RepeaterMode, RepeaterDuplex, RepeaterTone, RepeaterPosition, MemoryCallsign
from .icf import settings as _settings
from .icf.settings.network import Field as NetworkField
from .icf.settings.extended import FixedValue as FixedValue
class ErrorData:
    @staticmethod
    def UnsupportedLanguage() -> ErrorData: ...
    @staticmethod
    def UnregisteredField(key: int) -> ErrorData: ...
    @staticmethod
    def InvalidIndex() -> ErrorData: ...
    @staticmethod
    def InvalidSymbolWidth() -> ErrorData: ...
    @staticmethod
    def AmbiguousField(key: int) -> ErrorData: ...
    @property
    def domain(self) -> str: ...
    @property
    def kind(self) -> str: ...
    @property
    def diagnostic(self) -> Diagnostic: ...
    @property
    def key(self) -> int | None: ...
    def with_key(self, value: int) -> ErrorData: ...
    def localized(self, language: Language) -> str: ...
    def exception(self) -> Error: ...
    def __str__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __copy__(self) -> ErrorData: ...
    def __deepcopy__(self, memo: dict[int, object]) -> ErrorData: ...
class Language(Enum):
    ALL: ClassVar[tuple[Language, ...]]
    def code(self) -> str: ...
    English = 0
    Japanese = 1
    German = 2
    French = 3
    Spanish = 4
    Italian = 5
class ChannelField(Enum):
    FrequencyHz = 0
    Duplex = 1
    Selection = 2
    Tone = 3
    Dtcs = 4
    Polarity = 5
    DigitalSquelch = 6
    DigitalCode = 7
class RepeaterField(Enum):
    Mode = 0
    Tone = 1
    ToneIndex = 2
    Use = 3
    Position = 4
    UtcOffset = 5
    GatewayIndex = 6
class Message:
    @property
    def variant(self) -> str: ...
    @property
    def value(self) -> int | None: ...
    @property
    def count(self) -> int | None: ...
    @staticmethod
    def Enabled() -> Message: ...
    @staticmethod
    def Disabled() -> Message: ...
    @staticmethod
    def NoSymbol() -> Message: ...
    @staticmethod
    def NotApplicable() -> Message: ...
    @staticmethod
    def AgcFast() -> Message: ...
    @staticmethod
    def AgcDelay100Millis() -> Message: ...
    @staticmethod
    def ReadOnly() -> Message: ...
    @staticmethod
    def Cancelled() -> Message: ...
    @staticmethod
    def NotPublished() -> Message: ...
    @staticmethod
    def PartialNotPublished() -> Message: ...
    @staticmethod
    def PartialPublished() -> Message: ...
    @staticmethod
    def WriteAcknowledged() -> Message: ...
    @staticmethod
    def ReadRadio() -> Message: ...
    @staticmethod
    def WriteRadio() -> Message: ...
    @staticmethod
    def SaveFile() -> Message: ...
    @staticmethod
    def ReadFile() -> Message: ...
    @staticmethod
    def Code(value: int) -> Message: ...
    @staticmethod
    def UnknownCode(value: int) -> Message: ...
    @staticmethod
    def Number(value: int) -> Message: ...
    @staticmethod
    def OutOfRange(value: int) -> Message: ...
    @staticmethod
    def RowsProcessed(count: int) -> Message: ...
class Value:
    @property
    def variant(self) -> str: ...
    @property
    def payload(self) -> bool | Agc | FilterShape | RepeaterMode | RepeaterDuplex | RepeaterTone | RepeaterPosition: ...
    @staticmethod
    def Boolean(value: bool) -> Value: ...
    @staticmethod
    def Agc(value: Agc) -> Value: ...
    @staticmethod
    def FilterShape(value: FilterShape) -> Value: ...
    @staticmethod
    def RepeaterMode(value: RepeaterMode) -> Value: ...
    @staticmethod
    def RepeaterDuplex(value: RepeaterDuplex) -> Value: ...
    @staticmethod
    def RepeaterTone(value: RepeaterTone) -> Value: ...
    @staticmethod
    def RepeaterPosition(value: RepeaterPosition) -> Value: ...
class FieldText:
    key: int
    name: str
    label: str
    def __init__(self, key: int, name: str, label: str) -> None: ...
class ValueText:
    raw: int
    text: str
    in_domain: bool
    def __init__(self, raw: int, text: str, in_domain: bool) -> None: ...
class Presenter:
    def __init__(self, value: Language) -> None: ...
    def language(self) -> Language: ...
    def field_label(self, key: int) -> str: ...
    def setting(self, value: _settings.Setting) -> FieldText: ...
    def setting_value(self, value: _settings.Setting, index: int, raw: int) -> ValueText: ...
    def choice(self, value: _settings.extended.ChoiceField, index: int, raw: int) -> ValueText: ...
    def choice_label(self, value: _settings.extended.ChoiceField, index: int) -> str: ...
    def fixed_value(self, value: FixedValue) -> str: ...
    def channel_label(self, value: ChannelField) -> str: ...
    def callsign_label(self, value: MemoryCallsign) -> str: ...
    def repeater_label(self, value: RepeaterField) -> str: ...
    def network_label(self, value: NetworkField) -> str: ...
    def symbol(self, raw: bytes) -> str: ...
    def message(self, value: Message) -> str: ...
    def value(self, value: Value) -> str: ...
    def diagnostic(self, value: Diagnostic) -> str: ...
def language_code(value: Language) -> str: ...
def parse_language(code: str) -> Language: ...
def localized_error(error: Diagnostic, value: Language) -> str: ...
def fixed_value_source_label(value: FixedValue) -> str: ...
