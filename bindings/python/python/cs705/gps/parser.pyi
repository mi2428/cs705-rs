from typing import Self, TypeVar
from collections.abc import Callable
from cs705 import Bool, Error
from cs705.csv import Locale
from cs705.csv import ErrorData as CsvErrorData
from cs705.csv.datetime import Context
from cs705.csv.dispatch import Binding
from .operations import Record
from .transfer import Parsed

T = TypeVar("T")

class Options:
    hemispheres: bytes
    group_name_seed: bytes
    def __init__(self, locale: Locale, datetime: Context, hemispheres: bytes, group_name_seed: bytes) -> None: ...
    def locale_snapshot(self) -> Locale:
        """Return an independent value; edits require set_locale to update Options."""
        ...
    def set_locale(self, value: Locale) -> None: ...
    def datetime_snapshot(self) -> Context:
        """Return an independent value; edits require set_datetime to update Options."""
        ...
    def set_datetime(self, value: Context) -> None: ...
class Rows:
    def __init__(self, source: bytes, options: Options) -> None: ...
    @staticmethod
    def with_lower(source: bytes, options: Options, lower: Callable[[bytes], bytes]) -> Rows: ...
    def binding(self, callback: Callable[[Binding], T]) -> T: ...
    def into_owned(self) -> Self: ...
    def __iter__(self) -> Self: ...
    def __next__(self) -> Draft: ...
class Draft:
    def record_snapshot(self) -> Record: ...
    def set_record(self, record: Record) -> None: ...
    group_code: int
    group_name: bytes
    text_corrections: int
    alarm_code: int | None
    @property
    def altitude_error(self) -> Error | None: ...
    @altitude_error.setter
    def altitude_error(self, value: Error | CsvErrorData | None) -> None: ...
    def __init__(self, record: Record, group_code: int, group_name: bytes, text_corrections: int, alarm_code: int | None, altitude_error: Error | CsvErrorData | None) -> None: ...
    def finalize(self, whole: bool, offset: int, alarm_seen: Bool) -> Parsed: ...
def valid_coordinate(raw: bytes, latitude: bool) -> bool: ...
