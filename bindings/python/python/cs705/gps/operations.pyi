from collections.abc import Iterable, Callable
from cs705.icf import Icf
from cs705.icf.context import Context
from cs705.csv.date_input import Clock

class Record:
    valid: bool
    bytes: bytes
    def __init__(self, valid: bool, bytes: bytes) -> None: ...
class Event:
    id: int
    synchronous: bool
    arg1: int
    arg2: int
    def __init__(self, id: int, synchronous: bool, arg1: int, arg2: int) -> None: ...
class Outcome:
    completed: int
    capacity_stopped: bool
    selection: tuple[int, int]
    def __init__(self, completed: int, capacity_stopped: bool, selection: tuple[int, int]) -> None: ...
def first_free_physical(image: Icf) -> int | None: ...
def copy(image: Icf, group: int, first: int, last: int) -> list[Record]: ...
def paste(image: Icf, group: int, first: int, source: Iterable[Record], limit: int) -> int: ...
def clear(image: Icf, group: int, first: int, last: int, seed: Record) -> int: ...
def rename_group_raw(image: Icf, group: int, name: bytes) -> None: ...
def insert(image: Icf, group: int, row: int, requested: int, selection: tuple[int, int], seed: Callable[[Icf], Record], notify: Callable[[Icf, Event], None]) -> Outcome: ...
def insert_initialized(image: Icf, group: int, row: int, requested: int, selection: tuple[int, int], q: Context, system_langid: int | None, clock: Callable[[], Clock], notify: Callable[[Icf, Event], None]) -> Outcome: ...
def delete(image: Icf, group: int, row: int, requested: int, notify: Callable[[Icf, Event], None]) -> int: ...
def carry(image: Icf, group: int, first: int, last: int, direction: int, notify: Callable[[Icf, Event], None]) -> bool: ...
