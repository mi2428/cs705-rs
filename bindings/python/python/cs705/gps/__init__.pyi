from cs705.icf import GpsCoordinate, GpsAltitude
from cs705 import Error as Error
from cs705.diagnostic import Diagnostic
from . import editor as editor, operations as operations, parser as parser, transfer as transfer

class ErrorData:
    @staticmethod
    def Invalid(line: int, reason: str) -> ErrorData: ...
    @staticmethod
    def Unsupported(line: int, reason: str) -> ErrorData: ...
    @staticmethod
    def RowIndexOutOfBounds(index: int) -> ErrorData: ...
    @property
    def domain(self) -> str: ...
    @property
    def kind(self) -> str: ...
    @property
    def diagnostic(self) -> Diagnostic: ...
    @property
    def reason(self) -> str | None: ...
    @property
    def line(self) -> int | None: ...
    @property
    def index(self) -> int | None: ...
    def with_reason(self, value: str) -> ErrorData: ...
    def with_line(self, value: int) -> ErrorData: ...
    def with_index(self, value: int) -> ErrorData: ...
    def exception(self) -> Error: ...
    def __str__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __copy__(self) -> ErrorData: ...
    def __deepcopy__(self, memo: object) -> ErrorData: ...

class Row:
    def cells(self) -> tuple[bytes, ...]: ...
    def into_owned(self) -> Row: ...
class Csv:
    @staticmethod
    def parse(source: bytes) -> Csv: ...
    def rows(self) -> list[Row]: ...
    def into_owned(self) -> Csv: ...
    def set_group(self, index: int, group: int) -> None: ...
    def set_group_name(self, index: int, value: bytes) -> None: ...
    def set_name(self, index: int, value: bytes) -> None: ...
    def set_alarm(self, index: int, value: bool) -> None: ...
    def set_latitude(self, index: int, value: GpsCoordinate) -> None: ...
    def set_longitude(self, index: int, value: GpsCoordinate) -> None: ...
    def set_altitude(self, index: int, value: GpsAltitude) -> None: ...
    def to_bytes(self) -> bytes: ...
