from collections.abc import Iterable, Callable
from typing import ClassVar
from cs705 import Error
from cs705.icf import Icf, ErrorData as ImageErrorData
from cs705.csv import ErrorData as CsvErrorData
from cs705.csv import Locale
from cs705.csv.control import Counts
from cs705.csv.datetime import Context, Time, DateToken
from cs705.csv.payload import Request
from .operations import Record
from .parser import Options

class Scope:
    Whole: ClassVar[Scope]
    @staticmethod
    def Group(group: int) -> Scope: ...
    @property
    def variant(self) -> str: ...
    @property
    def group(self) -> int | None: ...
class Failure:
    @staticmethod
    def Text(error: Error | CsvErrorData) -> Failure: ...
    @staticmethod
    def Image(error: Error | ImageErrorData) -> Failure: ...
    @property
    def variant(self) -> str: ...
    @property
    def error(self) -> Error: ...
    @error.setter
    def error(self, value: Error | CsvErrorData | ImageErrorData) -> None: ...
class Parsed:
    def record_snapshot(self) -> Record: ...
    def set_record(self, v: Record) -> None: ...
    group: int
    group_name: bytes
    corrections: int
    alarm: bool
    def __init__(self, record: Record, group: int, group_name: bytes, corrections: int, alarm: bool) -> None: ...
class Import:
    def counts_snapshot(self) -> Counts: ...
    def set_counts(self, v: Counts) -> None: ...
    rows_read: int
    applied: int
    def failure_snapshot(self) -> Failure | None: ...
    def set_failure(self, value: Failure | None) -> None: ...
    def __init__(self, counts: Counts, rows_read: int, applied: int, failure: Failure | None) -> None: ...
class Export:
    bytes: bytes
    rows: int
    def failure_snapshot(self) -> Failure | None: ...
    def set_failure(self, value: Failure | None) -> None: ...
    def __init__(self, bytes: bytes, rows: int, failure: Failure | None) -> None: ...
def import_csv(image: Icf, scope: Scope, source: bytes, options: Options, alarm_seen: bool) -> Import: ...
def import_decoded(image: Icf, scope: Scope, rows: Iterable[Parsed], alarm_seen: bool) -> Import: ...
def export_csv(image: Icf, scope: Scope, locale: Locale, native: Callable[[Request], bytes]) -> Export: ...
def export_csv_formatted(image: Icf, scope: Scope, locale: Locale, context: Context, failed_time: Time, native: Callable[[DateToken], bytes]) -> Export: ...
