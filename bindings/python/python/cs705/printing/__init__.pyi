from enum import Enum
from collections.abc import Callable, Iterable
from ..display import Resources as Resources, Views as Views, ViewState as ViewState, ViewKind as ViewKind
from . import native as native
class Metrics:
    font_height: int
    em: int
    advance_em: int
    line_em: int
    padding: int
    def __init__(self, font_height: int, em: int, advance_em: int, line_em: int, padding: int) -> None: ...
    def validate(self) -> None: ...
class Paper:
    width: int
    height: int
    def __init__(self, width: int, height: int) -> None: ...
class Grid:
    name: str
    fixed_rows: int
    fixed_columns: int
    show_split: int
    def __init__(self, name: str, cells: Iterable[Iterable[str]], fixed_rows: int, fixed_columns: int, column_boundaries: Iterable[bool], row_boundaries: Iterable[bool], nodes: Iterable[Iterable[native.CellNode]] | None, factory: native.Factory | None, show_split: int) -> None: ...
    def cells_snapshot(self) -> list[list[str]]: ...
    def set_cells(self, value: Iterable[Iterable[str]]) -> None: ...
    def column_boundaries_snapshot(self) -> list[bool]: ...
    def set_column_boundaries(self, v: Iterable[bool]) -> None: ...
    def row_boundaries_snapshot(self) -> list[bool]: ...
    def set_row_boundaries(self, v: Iterable[bool]) -> None: ...
    def nodes_snapshot(self) -> list[list[native.CellNode]] | None: ...
    def set_nodes(self, value: Iterable[Iterable[native.CellNode]] | None) -> None: ...
    def factory_snapshot(self) -> native.Factory | None: ...
    def set_factory(self, value: native.Factory | None) -> None: ...
class Page:
    columns: range
    rows: range
    font_height: int
    attempts: int
    content_width: int
    content_height: int
    fits: bool
    def __init__(self, columns: range, rows: range, font_height: int, attempts: int, content_width: int, content_height: int, fits: bool) -> None: ...
class Layout:
    horizontal: bytes
    vertical: bytes
    def __init__(self, horizontal: bytes, vertical: bytes, pages: list[Page]) -> None: ...
    def pages_snapshot(self) -> list[Page]: ...
    def set_pages(self, pages: list[Page]) -> None: ...
class Editor:
    validation_guard: int
    visible: bool
    text: bytes
    def __init__(self, validation_guard: int, visible: bool, text: bytes) -> None: ...
class TextView:
    def __len__(self) -> int: ...
    def to_bytes(self) -> bytes: ...
class Event:
    @property
    def variant(self) -> str: ...
    @property
    def due_ms(self) -> int | None: ...
    @due_ms.setter
    def due_ms(self, value: int) -> None: ...
    @property
    def name(self) -> str | None: ...
    @name.setter
    def name(self, value: str) -> None: ...
    @staticmethod
    def BeginDoc() -> Event: ...
    @staticmethod
    def Tick(due_ms: int, name: str) -> Event: ...
    @staticmethod
    def NewPage() -> Event: ...
    @staticmethod
    def Page() -> Event: ...
    @staticmethod
    def EndDoc() -> Event: ...
    @staticmethod
    def ClearNames() -> Event: ...
class Job:
    cancelled: bool
    pages: int
    ended: bool
    @staticmethod
    def begin(names: Iterable[str]) -> Job: ...
    def events_snapshot(self) -> list[Event]: ...
    def set_events(self, v: list[Event]) -> None: ...
    def tick(self, render: Callable[[str, Job], None]) -> bool: ...
    def begin_page(self) -> None: ...
    def page_drawn(self) -> None: ...
    def finish(self) -> None: ...
    def remaining_names(self) -> tuple[str, ...]: ...
class HtmlBuffer:
    text: str
    def __init__(self, text: str) -> None: ...
class PredicateOrder(Enum):
    BaseFirst = 0
    DatasetFirst = 1
def axis_spans(sizes: Iterable[int], fixed: int, blocked: Iterable[bool], available: int) -> bytes: ...
def layout(grid: Grid, paper: Paper, metrics: Metrics) -> Layout: ...
def html_page(grid: Grid, page: Page, paper: Paper, metrics: Metrics, number: int) -> str: ...
def eligible(bc: int, order: PredicateOrder, dataset: Callable[[], bool]) -> bool: ...
def split_index(current: bytes, view: ViewState, index: int, expand: bool) -> int: ...
def sync_editor(editor: Editor, dispatch_phase1: Callable[[TextView], None]) -> None: ...
