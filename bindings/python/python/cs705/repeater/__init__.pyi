from cs705.icf import RepeaterCoordinate, RepeaterMode, RepeaterDuplex, RepeaterTone, RepeaterPosition
from cs705 import Error as Error
from cs705.diagnostic import Diagnostic
from . import editor as editor, fields as fields, finalize as finalize, groups as groups, parser as parser, predicate as predicate, staging as staging, transfer as transfer, working as working

class ErrorData:
    @staticmethod
    def Invalid(line: int, reason: str) -> ErrorData: ...
    @staticmethod
    def Unsupported(line: int, reason: str) -> ErrorData: ...
    @staticmethod
    def RowIndexOutOfBounds(index: int) -> ErrorData: ...
    @property
    def domain(self) -> str: ...
    @property
    def kind(self) -> str: ...
    @property
    def diagnostic(self) -> Diagnostic: ...
    @property
    def reason(self) -> str | None: ...
    @property
    def line(self) -> int | None: ...
    @property
    def index(self) -> int | None: ...
    def with_reason(self, value: str) -> ErrorData: ...
    def with_line(self, value: int) -> ErrorData: ...
    def with_index(self, value: int) -> ErrorData: ...
    def exception(self) -> Error: ...
    def __str__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __copy__(self) -> ErrorData: ...
    def __deepcopy__(self, memo: object) -> ErrorData: ...

class Row:
    def cells(self) -> tuple[bytes, ...]: ...
    def name_bytes(self) -> bytes: ...
    def sub_name_bytes(self) -> bytes: ...
    def into_owned(self) -> Row: ...
class Csv:
    @staticmethod
    def parse(source: bytes) -> Csv: ...
    def rows(self) -> list[Row]: ...
    def into_owned(self) -> Csv: ...
    def to_bytes(self) -> bytes: ...
    def set_name(self, index: int, value: bytes) -> None: ...
    def set_sub_name(self, index: int, value: bytes) -> None: ...
    def set_group_name(self, index: int, value: bytes) -> None: ...
    def set_repeater_call_sign(self, index: int, value: bytes) -> None: ...
    def set_gateway_call_sign(self, index: int, value: bytes) -> None: ...
    def set_group_number(self, index: int, value: int) -> None: ...
    def set_frequency_hz(self, index: int, value: int) -> None: ...
    def set_offset_hz(self, index: int, value: int) -> None: ...
    def set_repeater_tone_index(self, index: int, value: int) -> None: ...
    def set_rpt1_use(self, index: int, value: bool) -> None: ...
    def set_utc_offset_minutes(self, index: int, value: int) -> None: ...
    def set_latitude(self, index: int, value: RepeaterCoordinate) -> None: ...
    def set_longitude(self, index: int, value: RepeaterCoordinate) -> None: ...
    def set_mode(self, index: int, value: RepeaterMode) -> None: ...
    def set_duplex(self, index: int, value: RepeaterDuplex) -> None: ...
    def set_tone(self, index: int, value: RepeaterTone) -> None: ...
    def set_position(self, index: int, value: RepeaterPosition) -> None: ...
