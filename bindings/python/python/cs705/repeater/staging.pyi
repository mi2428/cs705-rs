from collections.abc import Iterable, Callable
from cs705.csv.control import Counts

class Record:
    bytes: bytes
    frequency_class: int
    def __init__(self, bytes: bytes, frequency_class: int) -> None: ...
    def group(self) -> int: ...
class Commit:
    @staticmethod
    def Delete(absolute: int) -> Commit: ...
    @staticmethod
    def Insert(absolute: int | None, group: int, record: Record) -> Commit: ...
    @staticmethod
    def NameByte(group: int, byte: int, value: int) -> Commit: ...
    @staticmethod
    def Reference(value: int) -> Commit: ...
    @staticmethod
    def GroupNotification(group: int) -> Commit: ...
    @property
    def variant(self) -> str: ...
    @property
    def absolute(self) -> int | None: ...
    @absolute.setter
    def absolute(self, value: int | None) -> None: ...
    @property
    def group(self) -> int | None: ...
    @group.setter
    def group(self, value: int) -> None: ...
    @property
    def byte(self) -> int | None: ...
    @byte.setter
    def byte(self, value: int) -> None: ...
    @property
    def value(self) -> int | None: ...
    @value.setter
    def value(self, value: int) -> None: ...
    @property
    def record(self) -> Record | None: ...
    @record.setter
    def record(self, value: Record) -> None: ...
class PreserveSource:
    raw: int
    first: int
    last: int
    unwritten: bool
    def __init__(self, raw: int, first: int, last: int, unwritten: bool) -> None: ...
class Staging:
    names: tuple[bytes, ...]
    def counts_snapshot(self) -> Counts: ...
    def set_counts(self, value: Counts) -> None: ...
    old_reference_existed: bool
    @staticmethod
    def preload(rows: Iterable[Record], names: Iterable[bytes], old_reference: int) -> Staging: ...
    @staticmethod
    def preload_fallible(rows: Iterable[Record], names: Iterable[bytes], old_reference: int) -> Staging: ...
    def rows(self) -> list[Record]: ...
    def pending_count(self) -> int: ...
    def first_reference_ordinal(self) -> int: ...
    def selected_row(self, input: Record, name: bytes, group: int, clone_header: bytes, delta: int) -> int: ...
    def whole_row(self, input: Record, name: bytes, clone_header: bytes, delta: int) -> None: ...
    def finish_whole(self) -> None: ...
    def flush_selected(self, group: int, old_start: int, old_count: int, apply: Callable[[Commit], None]) -> None: ...
    def flush_whole(self, old_total: int, apply: Callable[[Commit], None]) -> None: ...
def same(a: Record, b: Record) -> bool: ...
def classify(row: Record) -> int: ...
def classify_bytes(bytes: bytes) -> int: ...
def restored_reference(rows: Iterable[Record], new_absolute_start: int, old_reference: Record) -> int: ...
class Records:
    def __init__(self, rows: Iterable[Record]) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Record: ...
    def __setitem__(self, index: int, value: Record) -> None: ...
    def to_list(self) -> list[Record]: ...
def restore_use(rows: Records, source: PreserveSource, read_budget: int, read: Callable[[int, int], Record], save: Callable[[int, Record], None]) -> None: ...
