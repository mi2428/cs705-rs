from typing import ClassVar
from enum import Enum
from collections.abc import Callable, Iterable
from cs705 import Error
from cs705.icf import Icf, ErrorData as ImageErrorData
from cs705.csv import ErrorData as CsvErrorData
from cs705.csv import Locale
from cs705.csv.control import Counts
from cs705.csv.nls import Bytes
from .parser import Options
from .working import Working, DefaultContext
from .staging import Record, PreserveSource

class Scope:
    Whole: ClassVar[Scope]
    @staticmethod
    def Group(group: int) -> Scope: ...
    @property
    def variant(self) -> str: ...
    @property
    def group(self) -> int | None: ...
class ImportMode(Enum):
    Merge = 0
    PreserveUse = 1
    Replace = 2
class Failure:
    @staticmethod
    def Text(error: Error | CsvErrorData) -> Failure: ...
    @staticmethod
    def Image(error: Error | ImageErrorData) -> Failure: ...
    @property
    def variant(self) -> str: ...
    @property
    def error(self) -> Error: ...
    @error.setter
    def error(self, value: Error | CsvErrorData | ImageErrorData) -> None: ...
class UnwrittenSource:
    source: PreserveSource
    read_budget: int
    read: Callable[[int, int], Record]
    def __init__(self, source: PreserveSource, read_budget: int, read: Callable[[int, int], Record]) -> None: ...
class ImportOptions:
    mode: ImportMode
    parser: Options
    def context_snapshot(self) -> DefaultContext: ...
    def set_context(self, v: DefaultContext) -> None: ...
    def reset_words_snapshot(self) -> list[int]: ...
    def set_reset_words(self, v: Iterable[int]) -> None: ...
    unwritten: UnwrittenSource | None
    def __init__(self, mode: ImportMode, parser: Options, context: DefaultContext, reset_words: Iterable[int], unwritten: UnwrittenSource | None) -> None: ...
class Import:
    def counts_snapshot(self) -> Counts: ...
    def set_counts(self, v: Counts) -> None: ...
    rows_read: int
    applied: int
    def group_notifications_snapshot(self) -> list[int]: ...
    def set_group_notifications(self, v: Iterable[int]) -> None: ...
    def failure_snapshot(self) -> Failure | None: ...
    def set_failure(self, value: Failure | None) -> None: ...
    def __init__(self, counts: Counts, rows_read: int, applied: int, group_notifications: Iterable[int], failure: Failure | None) -> None: ...
class Export:
    bytes: bytes
    rows: int
    def failure_snapshot(self) -> Failure | None: ...
    def set_failure(self, value: Failure | None) -> None: ...
    def __init__(self, bytes: bytes, rows: int, failure: Failure | None) -> None: ...
def export_csv(image: Icf, scope: Scope, locale: Locale, context: DefaultContext) -> Export: ...
def export_working_csv(image: Working, scope: Scope, locale: Locale) -> Export: ...
def import_csv(image: Icf, scope: Scope, source: bytes, options: ImportOptions) -> Import: ...
def import_working_csv(image: Working, scope: Scope, source: bytes, options: ImportOptions, nls: Callable[[bytes, Bytes], int]) -> Import: ...
def import_csv_merge(image: Working, scope: Scope, source: bytes, options: Options, reset: Iterable[int], nls: Callable[[bytes, Bytes], int]) -> Import: ...
