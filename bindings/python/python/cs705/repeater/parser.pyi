from typing import Self
from collections.abc import Callable
from cs705.csv import Locale
from cs705.csv.datetime import Context
from cs705.csv.nls import Bytes
from .fields import TypeSource
from .finalize import OffsetProfile
from .staging import Record

class FrequencyProfile:
    identity_class: int
    def offset_snapshot(self) -> OffsetProfile: ...
    def set_offset(self, value: OffsetProfile) -> None: ...
    def __init__(self, identity_class: int, offset: OffsetProfile) -> None: ...
class Options:
    def locale_snapshot(self) -> Locale: ...
    def set_locale(self, value: Locale) -> None: ...
    datetime: Context
    default: Record
    types: TypeSource
    group_name_seed: bytes
    crt_decimal: int
    frequency: Callable[[int], FrequencyProfile]
    def __init__(self, locale: Locale, datetime: Context, default: Record, types: TypeSource, group_name_seed: bytes, crt_decimal: int, frequency: Callable[[int], FrequencyProfile]) -> None: ...
class Parsed:
    def record_snapshot(self) -> Record: ...
    def set_record(self, v: Record) -> None: ...
    group_name: bytes
    corrections: int
    accepted: bool
    def __init__(self, record: Record, group_name: bytes, corrections: int, accepted: bool) -> None: ...
class Rows:
    def __init__(self, source: bytes, locale: Locale) -> None: ...
    def into_owned(self) -> Self: ...
    def next_with(self, row: Record, options: Options, nls: Callable[[bytes, Bytes], int]) -> Parsed | None: ...
