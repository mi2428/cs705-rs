from collections.abc import Iterable
from cs705.icf import Icf

class Groups:
    def counts_snapshot(self) -> list[int]: ...
    def set_counts(self, v: Iterable[int]) -> None: ...
    names: tuple[bytes, ...]
    def references_snapshot(self) -> list[int]: ...
    def set_references(self, v: Iterable[int]) -> None: ...
    def __init__(self, counts: Iterable[int], names: Iterable[bytes], references: Iterable[int]) -> None: ...
    @staticmethod
    def from_working(memory: bytes) -> Groups: ...
    @staticmethod
    def from_icf(image: Icf) -> Groups: ...
    def total(self) -> int: ...
    def start(self, group: int) -> int: ...
    def end(self, group: int) -> int: ...
    def group_of(self, absolute: int) -> int: ...
    def after_delete(self, group: int, relative: int, reset: Iterable[int]) -> None: ...
    def after_insert(self, group: int, relative: int, reset: Iterable[int]) -> None: ...
    def after_paste(self, group: int, first: int, last: int, reset: Iterable[int]) -> None: ...
    def after_clear(self, group: int, first: int, last: int) -> None: ...
    def after_carry(self, group: int, first: int, last: int, direction: int, reset: Iterable[int]) -> bool: ...
    def storage_tables(self) -> tuple[bytes, bytes]: ...
    def write_storage_tables_atomic(self, image: Icf) -> None: ...
    def write_references(self, image: Icf) -> None: ...
def rename_group_raw(image: Icf, group: int, name: bytes) -> None: ...
