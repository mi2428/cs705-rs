from collections.abc import Callable, Iterable
from cs705 import MutableBytes
from cs705.icf import Icf
from cs705.icf.context import Context
from cs705.icf.frequency import Ranges
from cs705.icf.record import DecodedRecord
from cs705.icf.special import Notification
from cs705.csv.nls import Bytes
from .groups import Groups

class DefaultContext:
    five_mhz: bool
    hemispheres: bytes
    def __init__(self, five_mhz: bool, hemispheres: bytes) -> None: ...
    @staticmethod
    def from_context(context: Context, system_langid: int | None) -> DefaultContext: ...
    def holder(self, group: int, binding: int) -> DecodedRecord: ...
class UseRange:
    first: int
    last: int
    def __init__(self, first: int, last: int) -> None: ...
class Working:
    @staticmethod
    def from_working(memory: bytes) -> Working: ...
    @staticmethod
    def from_icf(image: Icf, context: DefaultContext) -> Working: ...
    def working(self) -> bytes: ...
    def into_working(self) -> bytes: ...
    def groups(self) -> Groups: ...
    def bulk_use_range(self, group: int | None) -> UseRange: ...
    def bulk_use(self, range: UseRange, value: bool, binding: int, live: Callable[[], tuple[Ranges, Context]], enqueue: Callable[[Notification], None]) -> None: ...
    def rename_group_raw(self, group: int, name: bytes) -> None: ...
    def rebuild_storage(self) -> None: ...
    def to_icf(self) -> Icf: ...
    def load_into(self, index: int, holder: DecodedRecord) -> None: ...
    def save(self, index: int, holder: DecodedRecord) -> None: ...
    def save_reload(self, holder: DecodedRecord) -> None: ...
    def copy(self, group: int, first: int, last: int, seed: DecodedRecord) -> list[DecodedRecord]: ...
    def paste(self, group: int, first: int, source: Iterable[DecodedRecord], reset: Callable[[Working, int], int]) -> int: ...
    def clear(self, group: int, first: int, last: int, default: Callable[[Working], DecodedRecord]) -> None: ...
    def carry(self, group: int, first: int, last: int, direction: int, seed: DecodedRecord, reset: Callable[[Working, int], int]) -> bool: ...
    def delete_one(self, group: int, relative: int, seed: DecodedRecord, default: Callable[[Working], DecodedRecord], reset: Callable[[Working, int], int]) -> None: ...
    def insert_one(self, group: int, relative: int, seed: DecodedRecord, default: Callable[[Working], DecodedRecord], reset: Callable[[Working, int], int]) -> bool: ...
def expand_counts(image: MutableBytes) -> None: ...
def expand_rows(image: MutableBytes, context: DefaultContext) -> None: ...
def rebuild_storage_into(image: MutableBytes) -> None: ...
def load_into(image: bytes, index: int, holder: DecodedRecord) -> None: ...
def save_into(image: MutableBytes, index: int, holder: DecodedRecord) -> None: ...
def delete_into(image: MutableBytes, group: int, relative: int, seed: DecodedRecord, default: Callable[[Bytes], DecodedRecord], reset: Callable[[Bytes, int], int]) -> None: ...
