from .text import Reader, Report, Status as TextStatus
from typing import ClassVar

class Layout:
    @staticmethod
    def from_map_revision(value: int) -> Layout: ...
    def selector(self) -> int: ...
    def storage_len(self) -> int: ...
    def revision_offset(self) -> int: ...
    def signature_offset(self) -> int: ...

class Status:
    Success: ClassVar[Status]
    Signature: ClassVar[Status]
    @staticmethod
    def Reader(status: TextStatus) -> Status: ...
    @staticmethod
    def Coverage(status: TextStatus) -> Status: ...
    @property
    def kind(self) -> str: ...
    @property
    def status(self) -> TextStatus | None: ...

class FileImage:
    report: Report
    reader: Reader
    status: Status
    layout: Layout | None
    image: bytes
    def __init__(self, report: Report, reader: Reader, status: Status, layout: Layout | None, image: bytes) -> None: ...
    def convert_to(self, destination: Layout, seed: bytes | None) -> bytes: ...

def read(source: bytes) -> FileImage: ...
def read_bound(source: bytes, image: bytes) -> FileImage: ...
def read_fragments(fragments: list[bytes | None]) -> FileImage: ...
def validate_image(image: bytes, layout: Layout) -> bool: ...
def write_storage(image: bytes, layout: Layout, comment: bytes, extra_data: int) -> bytes: ...
def write_storage_with_checksum(image: bytes, layout: Layout, comment: bytes, extra_data: int, checksum: bool) -> bytes: ...
