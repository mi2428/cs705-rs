from collections.abc import Iterable
from . import MemoryCallsign
from .frequency import Ranges
from .record import DecodedRecord

class Sources:
    def __init__(self, current: bytes, defaults: bytes, ranges: Ranges, system_langid: int | None) -> None: ...
    current: bytes
    defaults: bytes
    ranges: Ranges
    system_langid: int | None

class ReadInputs:
    def __init__(self, ur_name_tail: bytes | None, blank_source_index: int | None, initial_first_marker: int | None, string_tail: bytes) -> None: ...
    @staticmethod
    def default() -> ReadInputs: ...
    ur_name_tail: bytes | None
    blank_source_index: int | None
    initial_first_marker: int | None
    string_tail: bytes

class ListSelection:
    def __init__(self, category: int, name: int, call: int, modal_result: int, checkbox: bool) -> None: ...
    category: int
    name: int
    call: int
    modal_result: int
    checkbox: bool
class ListOutcome:
    def __init__(self, modal_result: int, save: bool, copied: bool, checkbox: bool, mode: int) -> None: ...
    modal_result: int
    save: bool
    copied: bool
    checkbox: bool
    mode: int
class ListItem:
    def __init__(self, row: int, text: bytes) -> None: ...
    row: int
    text: bytes
class Category:
    def __init__(self, tag: int, text: bytes) -> None: ...
    tag: int
    text: bytes
class DialogOutcome:
    def __init__(self, accepted: bool, save: bool, checkbox: bool) -> None: ...
    accepted: bool
    save: bool
    checkbox: bool
class ListModel:
    def __init__(self, categories: list[Category], names: list[ListItem], calls: list[bytes], tag: int) -> None: ...
    categories: list[Category]
    names: list[ListItem]
    calls: list[bytes]
    tag: int

class Action:
    @staticmethod
    def SourceText(value: bytes) -> Action: ...
    @staticmethod
    def UrText(value: bytes) -> Action: ...
    @staticmethod
    def RepeaterText(value: bytes) -> Action: ...
    @staticmethod
    def SourceList(value: ListSelection) -> Action: ...
    @staticmethod
    def UrList(value: ListSelection) -> Action: ...
    @staticmethod
    def Designation(selected: int, accept: bool) -> Action: ...
    @staticmethod
    def Mode(value: int) -> Action: ...
    @property
    def kind(self) -> str: ...
    @property
    def text(self) -> bytes | None: ...
    @property
    def selection(self) -> ListSelection | None: ...
    @property
    def selected(self) -> int | None: ...
    @property
    def accept(self) -> bool | None: ...
    @property
    def mode(self) -> int | None: ...

class ByteRows:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> bytes: ...
    def __setitem__(self, index: int, value: bytes) -> None: ...
    def __delitem__(self, index: int) -> None: ...
    def append(self, value: bytes) -> None: ...

class Dialog:
    def __init__(self, holder: DecodedRecord, other: DecodedRecord, mode: int, source: bytes, your: bytes, repeater_text: bytes, repeater_caption: bytes, source_class: int, your_class: int, selected: int, first_marker: int | None, end_marker: int, repeater_flag: int, repeater_enabled: bool, checkbox: bool, last_list_mode: int | None, candidates: Iterable[bytes], preview: Iterable[bytes]) -> None: ...
    mode: int
    source: bytes
    your: bytes
    repeater_text: bytes
    repeater_caption: bytes
    source_class: int
    your_class: int
    selected: int
    first_marker: int | None
    end_marker: int
    repeater_flag: int
    repeater_enabled: bool
    checkbox: bool
    last_list_mode: int | None
    holder: DecodedRecord
    other: DecodedRecord
    @property
    def candidates(self) -> ByteRows: ...
    @candidates.setter
    def candidates(self, value: Iterable[bytes]) -> None: ...
    @property
    def preview(self) -> ByteRows: ...
    @preview.setter
    def preview(self, value: Iterable[bytes]) -> None: ...
    @staticmethod
    def open(s: Sources, original: DecodedRecord, reads: ReadInputs) -> Dialog: ...
    def action(self, s: Sources, action: Action, reads: ReadInputs) -> None: ...
    def finish(self, original: DecodedRecord, modal_result: int) -> DialogOutcome: ...
    def list_model(self, s: Sources, source: bool, selection: ListSelection, reads: ReadInputs) -> ListModel: ...
    def initial_selection(self, s: Sources, source: bool, reads: ReadInputs) -> ListSelection: ...

def lookup_ur_name(s: Sources, query: bytes) -> int: ...
def lookup_repeater_name(s: Sources, query: bytes, mode: int) -> int: ...
def lookup_repeater(s: Sources, query: bytes, optional_prefix: bytes | None, selector: int, mode: int) -> int: ...
def lookup_rpt2(s: Sources, prefix: bytes, query: bytes, flag: int, mode: int) -> int: ...
def slash_call(call: bytes, reads: ReadInputs) -> bytes: ...
def list_model(s: Sources, list_mode: int, mode: int, selection: ListSelection, reads: ReadInputs) -> ListModel: ...
def list_into(sources: Sources, holder: DecodedRecord, field: MemoryCallsign, selection: ListSelection, reads: ReadInputs) -> ListOutcome: ...
def initial_selection(s: Sources, holder: DecodedRecord, list_mode: int, query: bytes, other_mode: int, reads: ReadInputs) -> ListSelection: ...
def prepare_metadata(s: Sources, h: DecodedRecord) -> None: ...
def apply_requests(s: Sources, target: DecodedRecord, other: DecodedRecord, source: int, your: int, rpt: int, raw: bytes, reads: ReadInputs) -> None: ...
