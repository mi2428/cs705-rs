from enum import Enum
from collections.abc import Callable, Iterable
from cs705.clone import Session as CloneSession, SessionConfig, Outcome
from . import Document, Session, DefaultSource, ValidationSource, ValidationReport, CloneControls
from .initial import InitialBoundary, InitialState
class CloneReadStop(Enum):
    Cancelled = 0
    Busy = 1
    ProbeFailed = 2
    ContextMismatch = 3
    ReadFailed = 4
    Completed = 5
class CloneReadReply:
    Continue: CloneReadReply
    @staticmethod
    def Probe(outcome: Outcome) -> CloneReadReply: ...
    @staticmethod
    def Read(outcome: Outcome) -> CloneReadReply: ...
    @property
    def kind(self) -> str: ...
    @property
    def outcome(self) -> Outcome | None: ...
class CloneReadStep:
    @staticmethod
    def Query(session: CloneSession) -> CloneReadStep: ...
    @staticmethod
    def Read(session: CloneSession) -> CloneReadStep: ...
    @staticmethod
    def Sync(event: int) -> CloneReadStep: ...
    Apply: CloneReadStep
    @staticmethod
    def Stopped(stop: CloneReadStop) -> CloneReadStep: ...
    @property
    def kind(self) -> str: ...
    @property
    def session(self) -> CloneSession | None: ...
    @property
    def event(self) -> int | None: ...
    @property
    def stop(self) -> CloneReadStop | None: ...
class CloneRead:
    def __init__(self, config: SessionConfig, prompt_result: int) -> None: ...
    def advance(self, session: Session, controls: CloneControls, reply: CloneReadReply) -> CloneReadStep: ...
    def finish_document(self, document: Document, session: Session, source: DefaultSource | None, validation: ValidationSource, boundary: Callable[[InitialBoundary, Document, Session], None]) -> CloneReadStop: ...
    def initial_snapshot(self) -> InitialState: ...
    def set_initial(self, value: InitialState) -> None: ...
    def outcomes_snapshot(self) -> list[Outcome]: ...
    def set_outcomes(self, outcomes: Iterable[Outcome]) -> None: ...
    def validation_snapshot(self) -> ValidationReport | None: ...
    def set_validation(self, value: ValidationReport | None) -> None: ...
    selector: int
    fc: int
    fd: int
