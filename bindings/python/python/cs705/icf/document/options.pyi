from collections.abc import Callable
from enum import Enum
class CloneOptionButton(Enum):
    Ok = 0
    Cancel = 1
    FormEvent = 2
class CloneOptions:
    def __init__(self, word: int, states: bytes) -> None: ...
    @staticmethod
    def open(word: int) -> CloneOptions: ...
    word: int
    states: bytes
    def initialize(self, index: int) -> None: ...
    def save(self, button: CloneOptionButton, getter: Callable[[int, CloneOptions], int]) -> bool: ...
    def press(self, button: CloneOptionButton) -> bool: ...
    def mask(self) -> int: ...
