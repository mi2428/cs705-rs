from collections.abc import Callable, Iterable
from enum import Enum
from typing import ClassVar
from .. import Icf
from ...csv.nls import Bytes
from .extended import ChoiceInput, FixedTextInput, TextEffect

class SelectionField(Enum):
    MyCall = 0
    TxMessage = 1
    ALL: ClassVar[tuple[SelectionField, ...]]
    def native_name(self) -> str: ...
    def feature_id(self) -> str: ...
    def key(self) -> int: ...
    def count(self) -> int: ...
    def active_base(self) -> int: ...
    def active_raw(self, image: Icf) -> int: ...
    def selected(self, image: Icf, index: int) -> bool: ...
    @staticmethod
    def find(name_or_id: str) -> SelectionField: ...
    def edit(self, image: Icf, index: int, input: ChoiceInput) -> SelectionEffect: ...

class TextField(Enum):
    MyCall = 0
    MyCallSuffix = 1
    TxMessage = 2
    ALL: ClassVar[tuple[TextField, ...]]
    def native_name(self) -> str: ...
    def feature_id(self) -> str: ...
    def key(self) -> int: ...
    def count(self) -> int: ...
    def width(self) -> int: ...
    @staticmethod
    def find(name_or_id: str) -> TextField: ...
    def raw(self, image: Icf, index: int) -> bytes: ...
    def store_encoded_message(self, image: Icf, index: int, bytes: bytes) -> None: ...
    def display(self, image: Icf, index: int) -> bytes: ...
    def edit(self, image: Icf, index: int, input: FixedTextInput, alignment: int) -> TextEffect: ...
    def edit_with_nls(self, image: Icf, index: int, input: FixedTextInput, alignment: int, map: Callable[[bytes, Bytes], int], upper: Callable[[Bytes], int]) -> TextEffect: ...

class SelectionEffect:
    def __init__(self, helper_accepted: bool, stored: bool, candidate: int | None, active_raw: int, notify_flags: int, popup_requested: bool) -> None: ...
    helper_accepted: bool
    stored: bool
    candidate: int | None
    active_raw: int
    notify_flags: int
    popup_requested: bool

class AllowedView:
    def __init__(self, prefix_count: int, bad: bool, duplicate_warning: bool, parent_enable_raw: int, raw: bytes, display: bytes) -> None: ...
    prefix_count: int
    bad: bool
    duplicate_warning: bool
    parent_enable_raw: int
    raw: bytes
    display: bytes

class AllowedEffect:
    def __init__(self, inserted: bool, stored: bool, full_warning: bool, view_bad: bool, duplicate_warning: bool, state_out: int, notify_flags: int, notifications: Iterable[int], display: bytes) -> None: ...
    @staticmethod
    def default() -> AllowedEffect: ...
    inserted: bool
    stored: bool
    full_warning: bool
    view_bad: bool
    duplicate_warning: bool
    state_out: int
    notify_flags: int
    @property
    def notifications(self) -> tuple[int, ...]: ...
    @notifications.setter
    def notifications(self, value: Iterable[int]) -> None: ...
    display: bytes

class ReflectorView:
    def __init__(self, valid: bool, raw: bytes | None, display: bytes) -> None: ...
    valid: bool
    raw: bytes | None
    display: bytes

def ur_physical_slots(image: Icf) -> list[int]: ...
def allowed_view(image: Icf, index: int) -> AllowedView: ...
def edit_allowed(image: Icf, index: int, input_code: int, input: FixedTextInput, alignment: int, effect: AllowedEffect) -> None: ...
def edit_allowed_with_nls(image: Icf, index: int, input_code: int, input: FixedTextInput, alignment: int, effect: AllowedEffect, map: Callable[[bytes, Bytes], int], upper: Callable[[Bytes], int]) -> None: ...
def reflector_view(image: Icf, index: int) -> ReflectorView: ...
