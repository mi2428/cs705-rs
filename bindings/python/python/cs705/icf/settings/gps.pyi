from collections.abc import Callable
from enum import Enum
from typing import ClassVar, Self
from .. import Icf
from ...csv.number import CoordinateDialog, CoordinateEvent
from ...csv.nls import Bytes
from . import Setting
from .extended import ChoiceInput, ChoiceEffect, NumberInput, NumberEffect, FixedTextInput, TextEffect

class Resources:
    system_langid: int | None
    language_descriptor: int | None
    def __init__(self, system_langid: int | None, language_descriptor: int | None) -> None: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
class AlarmField(Enum):
    Type = 0
    Group = 1
    ALL: ClassVar[tuple[AlarmField, ...]]
    def native_name(self) -> str: ...
    def feature_id(self) -> str: ...
    def key(self) -> int: ...
    def read(self, image: Icf) -> int: ...
    def choices(self, image: Icf) -> list[int]: ...
    def edit(self, image: Icf, input: ChoiceInput) -> ChoiceEffect: ...
class SentenceField(Enum):
    Nmea = 0
    Logger = 1
    ALL: ClassVar[tuple[SentenceField, ...]]
    def native_name(self) -> str: ...
    def feature_id(self) -> str: ...
    def key(self) -> int: ...
    def count(self) -> int: ...
    def paint(self, image: Icf, provider: Callable[[bytes, int], bytes]) -> bytes: ...
class CoordinateEffect:
    stored: bool
    raw: bytes
    gray: bool
    def __init__(self, stored: bool, raw: bytes, gray: bool) -> None: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    def __eq__(self, other: object) -> bool: ...
class SentenceEffect:
    stored: bool
    helper_changed: bool
    valid: bool
    selected: int
    def __init__(self, stored: bool, helper_changed: bool, valid: bool, selected: int) -> None: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    def __eq__(self, other: object) -> bool: ...
class SentenceEvent:
    Ok: ClassVar[SentenceEvent]
    Cancel: ClassVar[SentenceEvent]
    Close: ClassVar[SentenceEvent]
    Deactivate: ClassVar[SentenceEvent]
    OwnerDestroyed: ClassVar[SentenceEvent]
    @staticmethod
    def Choose(index: int, selected: bool) -> SentenceEvent: ...
    @property
    def kind(self) -> str: ...
    @property
    def index(self) -> int | None: ...
    @property
    def selected(self) -> bool | None: ...
    def with_choice(self, index: int, selected: bool) -> SentenceEvent: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    def __eq__(self, other: object) -> bool: ...
class SentenceDialog:
    cancelled: bool
    done: bool
    release_requested: bool
    def __init__(self, image: Icf, field: SentenceField) -> None: ...
    def selected(self) -> int: ...
    def valid(self) -> bool: ...
    def apply(self, image: Icf, event: SentenceEvent) -> SentenceEffect: ...
class NativeSymbolPairs:
    @staticmethod
    def read(bytes: bytes) -> NativeSymbolPairs: ...
class ChoiceField:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    setting: Setting
    def selector(self, image: Icf, resources: Resources) -> str: ...
    def edit(self, image: Icf, input: ChoiceInput, resources: Resources) -> ChoiceEffect: ...
class NumberField:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    setting: Setting
    def bounds(self, image: Icf) -> tuple[int, int]: ...
    def paint(self, image: Icf, resources: Resources) -> bytes: ...
    def edit(self, image: Icf, input: NumberInput, point: int, unit_output: bytes | None) -> NumberEffect: ...
    def edit_live(self, image: Icf, input: NumberInput, point: int, resources: Resources) -> NumberEffect: ...
class SymbolField:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    feature_id: str
    name: str
    count: int
    key: int
    def read(self, image: Icf, index: int) -> bytes: ...
    def select(self, image: Icf, index: int, input: ChoiceInput, resource: NativeSymbolPairs) -> ChoiceEffect: ...
    def edit(self, image: Icf, index: int, input: FixedTextInput) -> TextEffect: ...
    def edit_with_nls(self, image: Icf, index: int, input: FixedTextInput, map: Callable[[bytes, Bytes], int]) -> TextEffect: ...
class CoordinateField:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    feature_id: str
    name: str
    key: int
    longitude: bool
    area: bool
    def read(self, image: Icf) -> bytes: ...
    def dialog(self, image: Icf, current: bytes, first: int | None) -> CoordinateDialog: ...
    def phase2(self, image: Icf, source: bytes, current: bytes) -> CoordinateEffect: ...
    def apply_dialog(self, image: Icf, dialog: CoordinateDialog, event: CoordinateEvent, current: bytes) -> CoordinateEffect: ...
class TextField:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    feature_id: str
    name: str
    key: int
    count: int
    width: int
    def read(self, image: Icf, index: int) -> bytes: ...
    def budget(self, image: Icf) -> int: ...
    def edit(self, image: Icf, index: int, input: FixedTextInput) -> TextEffect: ...
    def edit_with_nls(self, image: Icf, index: int, input: FixedTextInput, map: Callable[[bytes, Bytes], int]) -> TextEffect: ...
ALARM_AREA: CoordinateField
def choice_fields() -> list[ChoiceField]: ...
def find_choice(name_or_id: str) -> ChoiceField: ...
def number_fields() -> list[NumberField]: ...
def symbol_fields() -> list[SymbolField]: ...
def find_symbol(name_or_id: str) -> SymbolField: ...
def coordinate_fields() -> list[CoordinateField]: ...
def find_coordinate(name_or_id: str) -> CoordinateField: ...
def text_fields() -> list[TextField]: ...
def find_text(name_or_id: str) -> TextField: ...
def find_sentence(name_or_id: str) -> SentenceField: ...
def paint_alarm_group(image: Icf, provider: Callable[[bytes, int], bytes]) -> bytes: ...
def gps_group_count_source(source: bytes, group: int) -> int: ...
def paint_altitude_raw(old: int, meter: bool) -> bytes: ...
def edit_altitude_raw(old: int, meter: bool, input: NumberInput, point: int, unit_output: bytes | None) -> NumberEffect: ...
def edit_altitude_live(old: int, image: Icf, input: NumberInput, point: int) -> NumberEffect: ...
