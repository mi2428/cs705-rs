from collections.abc import Callable
from enum import Enum
from .context import Context
from .record import DecodedRecord
from .special import FrequencyInput

class FrequencyRange:
    low: int
    high: int
    flag: int
    def __init__(self, low: int, high: int, flag: int) -> None: ...

class FrequencyContext:
    common_kind: int
    @property
    def l30(self) -> list[FrequencyRange] | RangeSource | None: ...
    @l30.setter
    def l30(self, value: list[FrequencyRange] | None) -> None: ...
    @property
    def l58(self) -> list[FrequencyRange] | RangeSource | None: ...
    @l58.setter
    def l58(self, value: list[FrequencyRange] | None) -> None: ...
    @property
    def l120(self) -> list[FrequencyRange] | RangeSource | None: ...
    @l120.setter
    def l120(self, value: list[FrequencyRange] | None) -> None: ...
    def __init__(self, common_kind: int, l30: list[FrequencyRange] | None, l58: list[FrequencyRange] | None, l120: list[FrequencyRange] | None) -> None: ...

class RangeSource:
    """Readonly live B container; mutable copies require explicit snapshot access."""
    def __len__(self, /) -> int: ...
    def items_snapshot(self) -> list[FrequencyRange]: ...

class Container(Enum):
    L8 = 0
    L30 = 1
    L58 = 2
    LA8 = 3
    LD0 = 4
    LF8 = 5
    L120 = 6
    L148 = 7
    L80 = 8

POPULATION_ORDER: tuple[Container, ...]

class Ranges:
    @staticmethod
    def unpopulated() -> Ranges: ...
    @staticmethod
    def generate(q: Context, system_langid: int | None) -> Ranges: ...
    def regenerate(self, selected: int, q: Context, system_langid: int | None) -> None: ...
    def regenerate_with(self, selected: int, q: Context, system_langid: int | None, before_clear: Callable[[Container], None]) -> None: ...
    def selected(self) -> int: ...
    def frequency_context(self, live_kind: int) -> FrequencyContext: ...
    def is_complete(self) -> bool: ...
    def source_q(self) -> bytes | None: ...
    def default_source_selector(self, system_langid: int | None) -> int: ...
    def list(self, which: Container) -> list[FrequencyRange]: ...
    def db98(self, frequency: int) -> Ranges: ...
    def eb64(self, live_q: Context, frequency: int) -> bool: ...
    def f32c(self, live_q: Context, frequency: int) -> bool: ...
    def ed3c(self, live_q: Context, frequency: int) -> bool: ...
    def ecdc(self, live_q: Context, frequency: int) -> bool: ...
    def eb98(self, frequency: int) -> bool: ...
    def ed70(self, frequency: int) -> int: ...
    def eecc(self, frequency: int) -> int: ...
    def ef4c(self, frequency: int) -> int: ...
    def f094(self, frequency: int) -> int: ...
    def f014(self, frequency: int) -> int: ...
    def efcc(self, frequency: int) -> int: ...
    def edf0(self, kind: int, frequency: int) -> int: ...
    def f760(self, kind: int, index: int, frequency: int) -> FrequencyRange: ...
    def f5c4(self, index: int, frequency: int) -> FrequencyRange: ...
    def frequency_input(self, kind: int, candidate: int) -> FrequencyInput: ...
    def frequency_text_input(self, kind: int, text: bytes, point: int) -> FrequencyInput: ...

def relationship(r: FrequencyRange, e: FrequencyRange) -> int: ...
def sort_native(list: list[FrequencyRange]) -> None: ...
def add(list: list[FrequencyRange], pending: FrequencyRange) -> bool: ...
def cut(list: list[FrequencyRange], input: FrequencyRange) -> bool: ...
def join_adjacent(list: list[FrequencyRange]) -> None: ...
def optional(list: list[FrequencyRange], input: FrequencyRange | None) -> None: ...
def intersection(a: FrequencyRange, b: FrequencyRange) -> FrequencyRange: ...
def offset_for_source(selected: int, class_: int) -> int: ...
def f20c(ranges: Ranges, system_langid: int | None, class_: int) -> int: ...
def common_bad(context: FrequencyContext | None, frequency: int) -> bool: ...
def previous_channel_bad(holder: DecodedRecord, context: FrequencyContext | None) -> bool: ...
def channel_frequency_bad(holder: DecodedRecord, ranges: Ranges, live_q: Context) -> bool: ...
def channel_bad(holder: DecodedRecord, ranges: Ranges, live_q: Context, broad: bool) -> bool: ...
def auto_repeater_bad(holder: DecodedRecord, ranges: Ranges, live_q: Context, numeric_only: bool, system_langid: int | None) -> bool: ...
