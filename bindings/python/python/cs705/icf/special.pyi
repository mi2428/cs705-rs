from enum import Enum
from collections.abc import Callable, Iterable
from typing import Final
from . import Icf
from .settings.extended import NumberInput, NumberEffect, BandwidthEffect

class PasteApproval:
    def __init__(self, tail: bool, overwrite: bool) -> None: ...
    tail: bool
    overwrite: bool

class CompactClipboard:
    def __init__(self, reserve_count: int, source_rows: Iterable[int], channels: Iterable[CompactChannel]) -> None: ...
    @staticmethod
    def default() -> CompactClipboard: ...
    reserve_count: int
    def source_rows_snapshot(self) -> list[int]: ...
    def set_source_rows(self, value: Iterable[int]) -> None: ...
    def channels_snapshot(self) -> list[CompactChannel]: ...
    def set_channels(self, value: Iterable[CompactChannel]) -> None: ...
    def copy(self, source: bytes, kind: CompactKind, range: range, only: bool) -> None: ...

class ScanClipboard:
    def __init__(self, rows: Iterable[ScanEdge], transfer_count: int) -> None: ...
    @staticmethod
    def default() -> ScanClipboard: ...
    transfer_count: int
    def rows_snapshot(self) -> list[ScanEdge]: ...
    def set_rows(self, value: Iterable[ScanEdge]) -> None: ...
    def copy(self, source: bytes, range: range, state: RowState) -> None: ...
    def paste(self, image: Icf, g: bytes, start: int, approval: PasteApproval, state: RowState, reset: bool) -> Effects: ...

class ScanField(Enum):
    Name = 0
    Mode = 1
    Data = 2
    Filter = 3

class ScanRowAction(Enum):
    Clear = 0
    Delete = 1
    Insert = 2
    Up = 3
    Down = 4

class CompactKind(Enum):
    BandStack = 0
    Memopad = 1
    def offset(self, row: int) -> int: ...
    def displayed_rows(self) -> range: ...

class CompactField(Enum):
    Frequency = 0
    Duplex = 1
    Offset = 2
    Mode = 3
    Data = 4
    Filter = 5
    Tone = 6
    TxTone = 7
    RxTone = 8
    Dtcs = 9
    Polarity = 10
    DigitalSquelch = 11
    DigitalCode = 12
    Your = 13
    Repeater1 = 14
    Repeater2 = 15
    def key(self) -> int: ...

class EdgeSide(Enum):
    Low = 0
    High = 1

class Notification:
    def __init__(self, event: int, synchronous: bool, first: int, second: int, payload: bytes) -> None: ...
    event: int
    synchronous: bool
    first: int
    second: int
    payload: bytes

class PresetField:
    def __init__(self, key: int, offset: int, mask: int, field: int, choices: int) -> None: ...
    key: int
    offset: int
    mask: int
    field: int
    choices: int

class FrequencyInput:
    def __init__(self, first_accepted: bool, second_value: int, second_accepted: bool) -> None: ...
    first_accepted: bool
    second_value: int
    second_accepted: bool

class CompactChannel:
    def __init__(self, valid: bool, frequency_hz: int, duplex: int, offset_hz: int, mode: int, data: int, filter: int, tone: int, tx_tone: int, rx_tone: int, dtcs: int, polarity: int, digital_squelch: int, digital_code: int, callsigns: tuple[bytes, bytes, bytes]) -> None: ...
    valid: bool
    frequency_hz: int
    duplex: int
    offset_hz: int
    mode: int
    data: int
    filter: int
    tone: int
    tx_tone: int
    rx_tone: int
    dtcs: int
    polarity: int
    digital_squelch: int
    digital_code: int
    callsigns: tuple[bytes, bytes, bytes]
    @staticmethod
    def read(source: bytes, kind: CompactKind, row: int) -> CompactChannel: ...
    @staticmethod
    def decode(raw: bytes) -> CompactChannel: ...
    @staticmethod
    def decode_valid(raw: bytes, valid: bool) -> CompactChannel: ...
    @staticmethod
    def decode_bound(source: bytes | None, valid: bool) -> CompactChannel: ...
    def display(self, field: CompactField) -> DisplayValue: ...
    def input_blocked(self, code: int, command: int) -> bool: ...
    def write_to(self, old: bytes, write: Callable[[int, bytes], None]) -> None: ...

class ScanEdge:
    def __init__(self, valid: bool, low_hz: int, high_hz: int, mode: int, data: int, filter: int, name: bytes) -> None: ...
    valid: bool
    low_hz: int
    high_hz: int
    mode: int
    data: int
    filter: int
    name: bytes
    @staticmethod
    def read(source: bytes, row: int) -> ScanEdge: ...
    def mode_candidate_allowed(self, candidate: int) -> bool: ...
    def filter_candidate_allowed(self, candidate: int) -> bool: ...
    def warnings(self, side: EdgeSide, bad: Callable[[int], bool]) -> int: ...
    def suitable(self, allow_empty: bool, allow_equal: bool, check_specific: bool, bad: Callable[[int], bool]) -> bool: ...
    def save(self, image: Icf, row: int) -> None: ...
    def save_with(self, row: int, flag: int, write: Callable[[int, bytes], None]) -> None: ...

class UserEdge:
    def __init__(self, valid: bool, low_hz: int, high_hz: int) -> None: ...
    valid: bool
    low_hz: int
    high_hz: int
    @staticmethod
    def read(source: bytes, row: int) -> UserEdge: ...
    @staticmethod
    def warnings(source: bytes, row: int, side: EdgeSide, bad: Callable[[int], bool], classify: Callable[[int], int]) -> tuple[int, bool]: ...

class Preset:
    def __init__(self, body: bytes, masks: bytes) -> None: ...
    body: bytes
    masks: bytes
    @staticmethod
    def read(source: bytes, p: int) -> Preset: ...
    def bandwidth_class(self) -> int: ...
    def combined_mode(self) -> int: ...
    def bandwidth_hz(self) -> int: ...
    def checkbox_paint(self, field: int) -> tuple[bytes, bool | None]: ...
    def bandwidth_paint(self) -> bytes: ...
    def paint_byte(self, key: int) -> int: ...
    def incompatible(self, field: int) -> bool: ...
    def has_enabled_fields(self) -> bool: ...
    def keying_candidate_allowed(self, which: int, candidate: int) -> bool: ...

PRESET_CATALOG: Final[tuple[PresetField, ...]]

class DisplayValue:
    Blank: DisplayValue
    Placeholder: DisplayValue
    @staticmethod
    def Number(value: int) -> DisplayValue: ...
    @staticmethod
    def Callsign(value: bytes) -> DisplayValue: ...
    @property
    def kind(self) -> str: ...
    @property
    def number(self) -> int | None: ...
    @property
    def callsign(self) -> bytes | None: ...

class Notifications:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Notification: ...
    def __setitem__(self, index: int, value: Notification) -> None: ...
    def __delitem__(self, index: int) -> None: ...
    def append(self, value: Notification) -> None: ...
    def clear(self) -> None: ...

class Effects:
    def __init__(self, writes: int, callback_flags: int, phase: int | None, warning_bits: int, gray: bool, blocked: bool, node_style_clear: int, notifications: Iterable[Notification]) -> None: ...
    @staticmethod
    def default() -> Effects: ...
    writes: int
    callback_flags: int
    phase: int | None
    warning_bits: int
    gray: bool
    blocked: bool
    node_style_clear: int
    @property
    def notifications(self) -> Notifications: ...
    @notifications.setter
    def notifications(self, value: Iterable[Notification]) -> None: ...
    def dispatch(self, send: Callable[[Notification], None]) -> None: ...

class RowState:
    def __init__(self, bits: int, start: int, end: int, active: int, state: int) -> None: ...
    @staticmethod
    def default() -> RowState: ...
    bits: int
    start: int
    end: int
    active: int
    state: int

class PresetNumberEffect:
    def __init__(self, editor: NumberEffect, effects: Effects) -> None: ...
    editor: NumberEffect
    effects: Effects
class PresetBandwidthEffect:
    def __init__(self, editor: BandwidthEffect | None, effects: Effects) -> None: ...
    editor: BandwidthEffect | None
    effects: Effects

def selected_scan_raw(image: bytes) -> int: ...
def select_scan(image: Icf, g: bytes, row: int, reset: bool) -> None: ...
def scan_reset_enabled(source: bytes, index: int) -> bool: ...
def decode_bandwidth(class_: int, /, raw: int) -> int: ...
def encode_bandwidth(class_: int, /, width: int) -> int: ...
def scan_suitable_rows(source: bytes, live_current: bytes, allow_empty: bool, allow_equal: bool, check_specific: bool, bad: Callable[[int], bool]) -> list[int]: ...
def reset_compact(image: Icf, g: bytes, kind: CompactKind, confirmation: int, only: bool) -> Effects: ...
def reset_preset(image: Icf, g: bytes, p: int, confirmation: int) -> Effects: ...
def toggle_preset(image: Icf, g: bytes, p: int, field: int, grid_present: bool, code: int, live_preset: int) -> Effects: ...
def commit_preset(image: Icf, g: bytes, p: int, key: int, side: int, accepted: int | None, live_preset: int) -> Effects: ...
def edit_scan_field(image: Icf, row: int, field: ScanField, accepted: int | None, name: bytes | None) -> Effects: ...
def select_scan_raw(image: Icf, g: bytes, candidate: int, reset: bool) -> None: ...
def scan_rows(image: Icf, g: bytes, range: range, action: ScanRowAction, confirmed: bool, state: RowState, reset: bool) -> Effects: ...
def edit_scan_frequency(image: Icf, g: bytes, row: int, side: EdgeSide, input: FrequencyInput, reset: bool, bad: Callable[[int], bool]) -> Effects: ...
def edit_user_frequency(image: Icf, row: int, side: EdgeSide, input: FrequencyInput, bad: Callable[[int], bool], classify: Callable[[int], int]) -> Effects: ...
def rename_preset(image: Icf, g: bytes, q: int, live_preset: int, name: bytes | None, label: Callable[[bytes], bytes], notify: Callable[[Notification], None]) -> Effects: ...
def bandwidth_input(class_: int, old_raw: int, input: NumberInput, crt_point: int) -> BandwidthEffect: ...
def edit_preset_bandwidth(image: Icf, g: bytes, p: int, input: NumberInput, crt_point: int, live_preset: int) -> PresetBandwidthEffect: ...
def edit_preset_number(image: Icf, g: bytes, p: int, key: int, input: NumberInput, crt_point: int, live_preset: int) -> PresetNumberEffect: ...
