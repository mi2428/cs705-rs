from enum import Enum
import builtins
from typing import Self
from collections.abc import Callable, Iterable, Sequence
from . import ContextFields, ErrorData, Identity, IdentityGate, Outcome, SessionConfig, Transport
from .search import Candidate, Filter, Observation
from ..icf.document import DefaultSource, Document, Session
from ..icf.document.initial import InitialState
from ..icf.document.lifecycle import UiState, RecentFiles

class Life(Enum):
    Absent = 0
    Open = 1
    ReleaseRequested = 2
    Destroyed = 3
class Event:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    name: str
    argument: int
    bytes: builtins.bytes
    def __init__(self, name: str, argument: int, bytes: builtins.bytes) -> None: ...
    def __eq__(self, other: object) -> bool: ...
class Cell:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    kind: int
    key: int
    span: bool
    selectable: bool
    text: bytes
    def __init__(self, kind: int, key: int, span: bool, selectable: bool, text: bytes) -> None: ...
    def __eq__(self, other: object) -> bool: ...
class NativeReturn:
    """Value object: with_value returns a replacement Returned value."""
    def with_value(self, value: int) -> NativeReturn: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    @property
    def kind(self) -> str: ...
    @property
    def value(self) -> int | None: ...
    @staticmethod
    def Returned(value: int) -> NativeReturn: ...
    @staticmethod
    def Exception() -> NativeReturn: ...
class ReadMode:
    """Value object: with_values returns a replacement Captured value."""
    def with_values(self, values: Iterable[int | ErrorData]) -> ReadMode: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    @property
    def kind(self) -> str: ...
    @property
    def values(self) -> list[int | ErrorData] | None: ...
    @staticmethod
    def Current() -> ReadMode: ...
    @staticmethod
    def Captured(values: Iterable[int | ErrorData]) -> ReadMode: ...
class SearchSource:
    """Copied observations; returned lists contain live owner-backed elements."""
    ready: int
    opened: bool | None
    @property
    def filters(self) -> list[Filter]: ...
    @filters.setter
    def filters(self, values: Sequence[Filter]) -> None: ...
    @property
    def observations(self) -> list[Observation]: ...
    @observations.setter
    def observations(self, values: Sequence[Observation]) -> None: ...
    prefix: bytes
    @property
    def suffixes(self) -> list[bytes]: ...
    @suffixes.setter
    def suffixes(self, v: Iterable[bytes]) -> None: ...
    def __init__(self, ready: int, opened: bool | None, filters: Sequence[Filter], observations: Sequence[Observation], prefix: bytes, suffixes: Iterable[bytes]) -> None: ...
class RegistrySource:
    @property
    def values(self) -> list[bytes | ErrorData]: ...
    @values.setter
    def values(self, v: Iterable[bytes | ErrorData]) -> None: ...
    crt_point: int | None
    def __init__(self, values: Iterable[bytes | ErrorData], crt_point: int | None) -> None: ...
class InformationSource:
    gate_context: ContextFields | None
    gate_flag: int
    display_context: ContextFields | None
    display_flag: int
    operation: int
    captions: tuple[bytes, bytes] | None
    def __init__(self, gate_context: ContextFields | None, gate_flag: int, display_context: ContextFields | None, display_flag: int, operation: int, captions: tuple[bytes, bytes] | None) -> None: ...
class ReturnSource:
    defaults: DefaultSource | None
    profile_return: int | None
    captions: tuple[bytes, bytes] | None
    @property
    def close_returns(self) -> list[NativeReturn]: ...
    @close_returns.setter
    def close_returns(self, v: Sequence[NativeReturn]) -> None: ...
    def __init__(self, defaults: DefaultSource | None, profile_return: int | None, captions: tuple[bytes, bytes] | None, close_returns: Sequence[NativeReturn]) -> None: ...
class DocumentReceiver:
    """Retains owner handles or active callback loans without consuming their state.

    Mutable document/session/initial and read-only recent access remain checked;
    scoped targets keep their original frame, thread, and interpreter limits.
    """
    document: Document
    session: Session
    initial: InitialState
    ui: UiState
    recent: RecentFiles
    def __init__(self, document: Document, session: Session, initial: InitialState, ui: UiState, recent: RecentFiles) -> None: ...
class Controller:
    """Owned state; collection getters return snapshot lists, not membership editors.

    Mutable candidate/event elements are live views; rebuilding expires old views.
    Earlier committed controller changes remain visible after an operation raises.
    """
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    def __eq__(self, other: object) -> bool: ...
    com: int
    text: bytes | None
    com_mode: int | None
    form: Life
    popup: Life
    @property
    def retired_popups(self) -> list[Life]: ...
    @retired_popups.setter
    def retired_popups(self, v: Iterable[Life]) -> None: ...
    information: Life
    pair_registered: bool
    selector: int
    fc: int
    fd: int
    identity: IdentityGate
    identity_result: int | None
    captions: tuple[bytes, bytes] | None
    @property
    def dropdown(self) -> list[int]: ...
    @dropdown.setter
    def dropdown(self, v: Iterable[int]) -> None: ...
    @property
    def candidates(self) -> list[Candidate]: ...
    @candidates.setter
    def candidates(self, values: Sequence[Candidate]) -> None: ...
    generation: int
    previous: int
    selected: int | None
    last_item_index: int | None
    search_result: int
    reidentify_requested: bool
    @property
    def events(self) -> list[Event]: ...
    @events.setter
    def events(self, values: Sequence[Event]) -> None: ...
    def __init__(self, com: int, resource_text: bytes, document: bytes) -> None: ...
    def choose(self, index: int) -> None: ...
    def input_text(self, text: bytes) -> None: ...
    def refresh(self, source: RegistrySource) -> None: ...
    def construct_com(self, source: RegistrySource, reads: ReadMode) -> None: ...
    def rescan(self, source: SearchSource) -> None: ...
    def startup(self, source: SearchSource | None) -> None: ...
    def open_search(self, source: SearchSource) -> None: ...
    def select(self, reads: ReadMode) -> None: ...
    def popup_close(self) -> None: ...
    def escape(self) -> None: ...
    def return_search(self, registry: RegistrySource) -> None: ...
    def manual_commit_current(self, busy_reads: Iterable[bool]) -> None: ...
    def manual_commit(self, getter_text: bytes, busy_reads: Iterable[bool]) -> None: ...
    def manual_commit_document(self, getter_text: bytes | None, busy_reads: Iterable[bool], receiver: DocumentReceiver) -> None: ...
    def request_reidentify_document(self, busy_reads: Iterable[bool], receiver: DocumentReceiver) -> None: ...
    def close_com(self, cancel: bool, returns: Sequence[NativeReturn]) -> None: ...
    def close_com_document(self, cancel: bool, returns: Sequence[NativeReturn], receiver: DocumentReceiver) -> None: ...
    def identify(self, identity: Identity, source: InformationSource) -> None: ...
    def query_requested(self, config: SessionConfig, transport: Transport, cancelled_callback: Callable[[], bool]) -> Outcome: ...
    def query_document(self, config: SessionConfig, transport: Transport, cancelled_callback: Callable[[], bool], receiver: DocumentReceiver) -> Outcome: ...
    def return_query(self, outcome: Outcome, receiver: DocumentReceiver, source: ReturnSource) -> None: ...
    def sync49_document(self, receiver: DocumentReceiver, close_returns: Sequence[NativeReturn]) -> bool: ...
    def information_rows(self) -> list[list[Cell]] | None: ...
    def information_selection(self, unit_locked: int, live_flags: int, previous: bool) -> bool: ...
    def information_close(self, click: bool) -> None: ...
    def destroy_retired_popup(self, index: int) -> None: ...
    def destroy(self, target: str) -> None: ...
    def destroy_document(self, target: str, receiver: DocumentReceiver) -> None: ...
