from enum import Enum
from typing import Callable, Iterable, Protocol, Self
from . import search as search, information as information
from .. import Error as Error

IMAGE_CAPACITY: int
class Direction(Enum):
    ToRadio = 0
    FromRadio = 1
Echo = Enum("Echo", ["None", "Known", "Auto"])
class Operation(Enum):
    Query = 0
    Read = 1
    Write = 2
class State(Enum):
    Startup = 0
    QuerySend = 1
    QueryWait = 2
    ReadSend = 3
    ReadWait = 4
    WriteStart = 5
    WriteData = 6
    WriteEnd = 7
    AckWait = 8
    Drain = 9
    Closed = 10
class WriteDisposition(Enum):
    NotStarted = 0
    Unconfirmed = 1
    Acknowledged = 2
ErrorKind = Enum("ErrorKind", ["NotFound", "PermissionDenied", "ConnectionRefused", "ConnectionReset", "HostUnreachable", "NetworkUnreachable", "ConnectionAborted", "NotConnected", "AddrInUse", "AddrNotAvailable", "NetworkDown", "BrokenPipe", "AlreadyExists", "WouldBlock", "NotADirectory", "IsADirectory", "DirectoryNotEmpty", "ReadOnlyFilesystem", "StaleNetworkFileHandle", "InvalidInput", "InvalidData", "TimedOut", "WriteZero", "StorageFull", "NotSeekable", "QuotaExceeded", "FileTooLarge", "ResourceBusy", "ExecutableFileBusy", "Deadlock", "CrossesDevices", "TooManyLinks", "InvalidFilename", "ArgumentListTooLong", "Interrupted", "Unsupported", "UnexpectedEof", "OutOfMemory", "Other"])

class Transport(Protocol):
    def read(self, maximum: int) -> bytes: ...
    def write(self, data: bytes) -> int: ...
    def flush(self) -> None: ...
    def now_ms(self) -> int: ...
    def wait_ms(self, milliseconds: int) -> None: ...
    def pending_output(self) -> int: ...
    def reconfigure(self, settings_token: bytes) -> None: ...
    def close(self) -> None: ...
class Profile:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    def __init__(self, selector: int) -> None: ...
    def selector(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
class ContextFields:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    values: list[int]
    def __init__(self, values: Iterable[int]) -> None: ...
    @staticmethod
    def from_tail(tail: bytes) -> ContextFields: ...
    def __eq__(self, other: object) -> bool: ...
class Identity:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    model: int
    revision: int
    tail: bytes
    def __init__(self, model: int, revision: int, tail: bytes) -> None: ...
    def validate(self) -> Profile: ...
    def context(self) -> ContextFields: ...
    def __eq__(self, other: object) -> bool: ...
class IdentityGate:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    def __eq__(self, other: object) -> bool: ...
    cached_model: int | None
    cached_tail: bytes | None
    def __init__(self) -> None: ...
    def apply(self, identity: Identity, context: ContextFields | None, saved_selector: int, flag57: int) -> int: ...
class Frame:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    @property
    def kind(self) -> str: ...
    identity: Identity
    address: int
    payload: bytes
    block_count: int
    @staticmethod
    def Identify() -> Frame: ...
    @staticmethod
    def Read() -> Frame: ...
    @staticmethod
    def Write() -> Frame: ...
    @staticmethod
    def Response(identity: Identity) -> Frame: ...
    @staticmethod
    def Data(address: int, payload: bytes) -> Frame: ...
    @staticmethod
    def End(block_count: int) -> Frame: ...
    @staticmethod
    def EndUncounted() -> Frame: ...
    @staticmethod
    def Acknowledgement() -> Frame: ...
    def encode(self, direction_value: Direction) -> bytes: ...
    @staticmethod
    def decode(wire: bytes, direction_value: Direction) -> Frame: ...
    def check_data_range(self, allowed: range) -> None: ...
    def __eq__(self, other: object) -> bool: ...
class Framer:
    def __init__(self) -> None: ...
    def push(self, byte: int) -> bytes | None: ...
    def finish(self) -> None: ...
class Extractor:
    def __init__(self) -> None: ...
    def push(self, bytes: bytes) -> None: ...
    def partial(self) -> bytes: ...
    def queued(self) -> int: ...
    def extract(self) -> bytes: ...
def decode_hex_script(text: bytes) -> bytes: ...
def script_token(script: bytes) -> tuple[bytes, int, bool]: ...
def read_range(selector: int) -> range: ...
def write_blocks(selector: int, mask: int) -> list[range]: ...
def write_blocks_with_cap(selector: int, mask: int, cap: int) -> list[range]: ...
def convert_image(image: bytes, source: Profile, destination: Profile, seed: bytes | None) -> bytes: ...

class TransportSettings:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    def __eq__(self, other: object) -> bool: ...
