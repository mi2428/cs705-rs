    flag57: int
    def __init__(self) -> None: ...
    def set_block_cap(self, cap: int) -> None: ...
class ErrorData:
    @staticmethod
    def Invalid(reason: str) -> ErrorData: ...
    @staticmethod
    def UnsupportedCommand(command: int) -> ErrorData: ...
    @staticmethod
    def ChecksumMismatch() -> ErrorData: ...
    @staticmethod
    def AddressOverflow() -> ErrorData: ...
    @staticmethod
    def SourceBounds() -> ErrorData: ...
    @staticmethod
    def Rejected(status: int) -> ErrorData: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    def __eq__(self, other: object) -> bool: ...
    @property
    def kind(self) -> str: ...
    @property
    def reason(self) -> str | None: ...
    @property
    def command(self) -> int | None: ...
    @property
    def status(self) -> int | None: ...
    def exception(self) -> Exception: ...
class Failure:
    """Value object: with_* returns a replacement; the original is unchanged."""
    def with_error(self, error: ErrorData) -> Failure: ...
    def with_code(self, code: int) -> Failure: ...
    def with_error_kind(self, kind: ErrorKind) -> Failure: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    @property
    def kind(self) -> str: ...
    @property
    def error(self) -> ErrorData | None: ...
    @property
    def code(self) -> int | None: ...
    @property
    def error_kind(self) -> ErrorKind | None: ...
    @staticmethod
    def Protocol(error: ErrorData) -> Failure: ...
    @staticmethod
    def Identity(code: int) -> Failure: ...
    @staticmethod
    def Io(kind: ErrorKind) -> Failure: ...
    @staticmethod
    def Reconfigure(kind: ErrorKind) -> Failure: ...
    @staticmethod
    def MalformedAck() -> Failure: ...
    @staticmethod
    def Cancelled() -> Failure: ...
    @staticmethod
    def Timeout() -> Failure: ...
    @staticmethod
    def EchoTimeout() -> Failure: ...
    @staticmethod
    def EchoMismatch() -> Failure: ...
    @staticmethod
    def Truncated() -> Failure: ...
    @staticmethod
    def EarlyResponse() -> Failure: ...
    @staticmethod
    def EndCount() -> Failure: ...
    @staticmethod
    def MissingCoverage() -> Failure: ...
    @staticmethod
    def ImageValidation() -> Failure: ...
    @staticmethod
    def OutsideImage() -> Failure: ...
    @staticmethod
    def OutsideCoverage() -> Failure: ...
    @staticmethod
    def DrainTimeout() -> Failure: ...
    @staticmethod
    def ClockRegressed() -> Failure: ...
    @staticmethod
    def SourceBounds() -> Failure: ...
    def result_code(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
class Outcome:
    """Native-produced result; there is no public constructor or restoration."""
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    operation: Operation
    failure: Failure | None
    close_error: ErrorKind | None
    identity: Identity | None
    identity_gate: IdentityGate
    image: bytes
    coverage: bytes
    blocks: int
    payload_bytes: int
    requested_wire_bytes: int
    transmitted_wire_bytes: int
    received_wire_bytes: int
    range_index: int
    next_address: int
    echo: Echo
    write_disposition: WriteDisposition
    terminal_phase: State
    def result_code(self) -> int: ...
    def acquired(self, address: int) -> bool: ...
class Session:
    @staticmethod
    def query(config: SessionConfig) -> Session: ...
    @staticmethod
    def read(config: SessionConfig, profile: Profile) -> Session: ...
    @staticmethod
    def read_after_query(config: SessionConfig, profile: Profile, query: Outcome) -> Session: ...
    @staticmethod
    def write(config: SessionConfig, profile: Profile, mask: int, image: bytes) -> Session: ...
    @staticmethod
    def write_after_query(config: SessionConfig, profile: Profile, mask: int, image: bytes, query: Outcome) -> Session: ...
    def run(self, transport: Transport, cancelled_callback: Callable[[], bool]) -> Outcome: ...
