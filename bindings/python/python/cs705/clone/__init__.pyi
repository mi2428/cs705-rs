    def __init__(self) -> None: ...
class SessionConfig:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    settings: TransportSettings
    block_cap: int
    counted_end: bool
    timeout_ms: int
    ack_timeout_ms: int
    drain_timeout_ms: int
    prepare_delay_ms: int
    range_gap_ms: int
    poll_ms: int
