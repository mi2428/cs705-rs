class SearchRecord:
    """slots is a snapshot list of live elements; replace it to edit membership."""
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    wave_in: int
    wave_out: int
    @property
    def slots(self) -> list[Slot]: ...
    @slots.setter
    def slots(self, values: Sequence[Slot]) -> None: ...
    def __init__(self, wave_in: int, wave_out: int, slots: Sequence[Slot]) -> None: ...
    def to_bytes(self) -> bytes: ...
    @staticmethod
    def from_bytes(bytes: bytes) -> SearchRecord: ...
    def __eq__(self, other: object) -> bool: ...
class Observation:
    """Inputs are copied; ports reads a snapshot list of owner-backed elements."""
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: dict[int, object]) -> Self: ...
    key: bytes
    base: bytes
    com: bytes
    hub: bytes
    audio: bytes
    parent_path: bool
    @property
    def ports(self) -> list[Port]: ...
    @ports.setter
    def ports(self, values: Sequence[Port]) -> None: ...
    wave_in: int
    wave_out: int
    def __init__(self, key: bytes, base: bytes, com: bytes, hub: bytes, audio: bytes, parent_path: bool, ports: Sequence[Port], wave_in: int, wave_out: int) -> None: ...
class SearchContext:
    """Result lists are snapshots of live records; rebuilding expires old elements."""
