    @results.setter
    def results(self, values: Sequence[SearchRecord]) -> None: ...
    def __init__(self) -> None: ...
    def search(self, filters_value: Sequence[Filter], observations_value: Sequence[Observation]) -> int: ...
    def get(self, index: int, out: MutableBytes) -> bool: ...
