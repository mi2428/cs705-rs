from collections.abc import Callable, Iterable
from enum import Enum
from typing import TypeVar

S = TypeVar('S')
R = TypeVar('R')
T = TypeVar('T')
class Message(Enum):
    NoData = 0
    NoChannelSpace = 1
    ChannelOver = 2
    GroupChannelOver = 3
    Discard = 4
    Correct = 5
class Counts:
    def __init__(self, s: int, c2: int, c3: int, c4: int) -> None: ...
    s: int
    c2: int
    c3: int
    c4: int
    def selected_event(self, code: int, delta: int) -> None: ...
    def whole_event(self, code: int, delta: int) -> None: ...
    def capacity_marker(self, status: int) -> None: ...
    def finish_selected(self, group_count: int) -> None: ...
    def messages(self) -> list[Message]: ...
class WriteResult:
    def __init__(self, bool_value: int, bytes_written: int) -> None: ...
    bool_value: int
    bytes_written: int
class ScanRow:
    def __init__(self, position: int, valid: bool, c2_delta: int, c3_delta: int) -> None: ...
    position: int
    valid: bool
    c2_delta: int
    c3_delta: int
class ScanRange:
    def __init__(self, base: int, last: int, stop_on_excess: bool) -> None: ...
    base: int
    last: int
    stop_on_excess: bool
class ImportGate:
    class FileCancelled(ImportGate):
        def __init__(self) -> None: ...
    class InnerCancelled(ImportGate):
        def __init__(self) -> None: ...
    class Header(ImportGate):
        def __init__(self, status: int) -> None: ...
        @property
        def status(self) -> int: ...
    def reaches_rows(self) -> bool: ...
    def reaches_stage9(self) -> bool: ...
def pair_correction(upper: int, lower_valid: bool, lower_c2: int, lower_c3: int, old_split: bool) -> int: ...
def scan_row(counts: Counts, row: ScanRow, range: ScanRange, apply: Callable[[int], object]) -> bool: ...
def export_ranges(header: bytes, ranges: Iterable[Iterable[bytes]], memory_ranges: bool, write: Callable[[bytes], WriteResult]) -> bool: ...
def export_memory(header: bytes, ranges: Iterable[Iterable[S]], pair: bool, build: Callable[[S], tuple[int, bytes] | None], write: Callable[[bytes], WriteResult]) -> bool: ...
def import_with_gate(state: S, gate: ImportGate, rows: Callable[[S], R], stage9: Callable[[S], T]) -> tuple[R | None, T | None]: ...
