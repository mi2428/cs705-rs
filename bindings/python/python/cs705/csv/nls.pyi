from collections.abc import Callable
from typing import overload
from .. import MutableBytes

class Bytes:
    def __len__(self) -> int: ...
    def to_bytes(self) -> bytes: ...
    @overload
    def __getitem__(self, index: int) -> int: ...
    @overload
    def __getitem__(self, index: slice) -> bytes: ...
    @overload
    def __setitem__(self, index: int, value: int) -> None: ...
    @overload
    def __setitem__(self, index: slice, value: bytes) -> None: ...
    def write(self, start: int, value: bytes) -> None: ...
class Profile:
    def __init__(self, uppercase: bool, keep_kana: bool, keep_spaces: bool, punctuation_exceptions: bytes, maximum: int) -> None: ...
    uppercase: bool
    keep_kana: bool
    keep_spaces: bool
    punctuation_exceptions: bytes
    maximum: int
def sanitize(bytes: MutableBytes, replacement: int) -> bool: ...
def name_candidate(shared: MutableBytes, maximum: int) -> bytes: ...
def trim_candidate(source: bytes) -> bytes: ...
def fold_callsign(raw: MutableBytes) -> bool: ...
def ascii_map(source: bytes, destination: MutableBytes) -> int: ...
def platform_map(source: bytes, destination: MutableBytes) -> int: ...
def platform_uppercase(bytes: MutableBytes) -> int: ...
def map_copy_back(shared: MutableBytes, native: Callable[[bytes, Bytes], int]) -> int | None: ...
def uppercase_copy(source: bytes, native: Callable[[Bytes], int]) -> bytes: ...
def callsign_fixed(shared: MutableBytes, native: Callable[[bytes, Bytes], int]) -> tuple[bytes, bool]: ...
def whole_text(shared: MutableBytes, profile: Profile, map: Callable[[bytes, Bytes], int], upper: Callable[[Bytes], int]) -> bytes: ...
def callsign_correction_count(c: int, name_changed: bool) -> int: ...
