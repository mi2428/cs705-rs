from collections.abc import Callable, Iterable, Iterator
from .. import MutableBytes, Error as Error
from ..diagnostic import Diagnostic
from . import channel as channel, control as control, datetime as datetime, dispatch as dispatch
from . import number as number, payload as payload, table as table, history as history, nls as nls, date_input as date_input

class ErrorData:
    @staticmethod
    def Limit(reason: str) -> ErrorData: ...
    @staticmethod
    def Invalid(reason: str) -> ErrorData: ...
    @staticmethod
    def Conversion(reason: str) -> ErrorData: ...
    @staticmethod
    def SourceUnavailable(reason: str) -> ErrorData: ...
    @staticmethod
    def Operation(reason: str) -> ErrorData: ...
    @property
    def domain(self) -> str: ...
    @property
    def kind(self) -> str: ...
    @property
    def diagnostic(self) -> Diagnostic: ...
    @property
    def reason(self) -> str: ...
    def with_reason(self, value: str) -> ErrorData: ...
    def exception(self) -> Error: ...
    def __str__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __copy__(self) -> ErrorData: ...
    def __deepcopy__(self, _memo: object) -> ErrorData: ...

class Locale:
    def __init__(self, decimal: int, list: int) -> None: ...
    @staticmethod
    def copied(decimal: int, list: int) -> Locale: ...
    decimal: int
    list: int
class Cells(Iterator[bytes]):
    def __init__(self, line: bytes, separator: int) -> None: ...
    def __iter__(self) -> Cells: ...
    def __next__(self) -> bytes: ...
    def next_cell(self) -> bytes | None: ...
    def into_owned(self) -> Cells: ...
OwnedCells = Cells
class Reader:
    def __init__(self, source: bytes, locale: Locale) -> None: ...
    def header(self) -> bytes: ...
    def original_bytes(self) -> bytes: ...
    def row(self, index: int) -> bytes | None: ...
    def rows(self) -> ReaderRows: ...
    def locale(self) -> Locale: ...
    def into_owned(self) -> Reader: ...
class ReaderRows(Iterator[bytes]):
    def __iter__(self) -> ReaderRows: ...
    def __next__(self) -> bytes: ...
def trim(value: bytes) -> bytes: ...
def is_lead(byte: int) -> bool: ...
def split_cells(line: bytes, separator: int) -> list[bytes]: ...
def column(line: bytes, index: int | None, separator: int) -> bytes | None: ...
def find_column_ascii(header: bytes, label: bytes, separator: int) -> int | None: ...
def find_column_with(header: bytes, label: bytes, separator: int, lower: Callable[[bytes], bytes]) -> int | None: ...
def fixed_text(source: bytes, width: int) -> tuple[bytes, bool]: ...
fixed_text_dynamic = fixed_text
def fixed_text_into(source: bytes, output: MutableBytes) -> bool: ...
def export_text(source: bytes, maximum: int) -> bytes: ...
def export_call(source: bytes, maximum: int) -> bytes: ...
def join(cells: Iterable[bytes], separator: int, crlf: bool) -> bytes: ...
