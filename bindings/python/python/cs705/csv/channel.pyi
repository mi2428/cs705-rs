from collections.abc import Callable, Iterator
from enum import Enum
from typing import TypeVar
from ..icf import Icf, ErrorData as IcfErrorData
from .. import Error
from ..icf.record import DecodedRecord
from ..icf.context import Context as IcfContext
from ..icf.frequency import Ranges
from ..repeater.working import DefaultContext
from . import Locale, ErrorData as CsvErrorData
from .control import Counts
from .dispatch import Binding
from .datetime import Context, DateToken
from .nls import Bytes

T = TypeVar('T')

class Kind(Enum):
    Memory = 0
    FixedPair = 1
    AlternatingPair = 2
    Scan = 3
    Callsign = 4
    UserEdge = 5
    @staticmethod
    def from_context(context: int) -> Kind: ...
class Selection:
    def __init__(self, first: int, last: int, number_base: int) -> None: ...
    first: int
    last: int
    number_base: int
class Failure:
    class Text(Failure):
        def __init__(self, error: Error | CsvErrorData) -> None: ...
        @property
        def error(self) -> Error: ...
    class Image(Failure):
        def __init__(self, error: Error | IcfErrorData) -> None: ...
        @property
        def error(self) -> Error: ...
    @property
    def kind(self) -> str: ...
    @property
    def error(self) -> Error: ...
class Import:
    def __init__(self, counts: Counts, rows_read: int, applied: int, failure: Failure | None) -> None: ...
    counts: Counts
    rows_read: int
    applied: int
    failure: Failure | None
class Export:
    def __init__(self, bytes: bytes, rows: int, failure: Failure | None) -> None: ...
    bytes: bytes
    rows: int
    failure: Failure | None
class MemoryImport:
    def __init__(self, report: Import, home_invalidated: bool, call_invalidated: bool) -> None: ...
    report: Import
    home_invalidated: bool
    call_invalidated: bool
class MemoryOptions:
    def __init__(self, locale: Locale, crt_decimal: int, generation: bytes, ranges: Ranges | None, live_q: IcfContext, system_langid: int | None) -> None: ...
    locale: Locale
    crt_decimal: int
    generation: bytes
    ranges: Ranges | None
    live_q: IcfContext
    system_langid: int | None
class MemoryRows(Iterator[bytes]):
    def __init__(self, source: bytes, kind: Kind, locale: Locale, whole: bool) -> None: ...
    def binding(self, call: Callable[[Binding], T]) -> T: ...
    def kind(self) -> Kind: ...
    def sequential(self) -> bool: ...
    def next_source(self) -> bytes | None: ...
    def __iter__(self) -> MemoryRows: ...
    def __next__(self) -> bytes: ...
    def into_owned(self) -> MemoryRows: ...
class EdgeRow:
    def __init__(self, holder: DecodedRecord, position: int, discard: int, corrections: int) -> None: ...
    holder: DecodedRecord
    position: int
    discard: int
    corrections: int
class UserEdgeRows(Iterator[EdgeRow]):
    def __init__(self, source: bytes, locale: Locale, selection: Selection, whole: bool) -> None: ...
    def next_row(self) -> EdgeRow | None: ...
    def __iter__(self) -> UserEdgeRows: ...
    def __next__(self) -> EdgeRow: ...
    def into_owned(self) -> UserEdgeRows: ...
class ScanRows:
    def __init__(self, source: bytes, locale: Locale, selection: Selection, whole: bool) -> None: ...
    def next_with(self, default: DecodedRecord, crt_decimal: int) -> EdgeRow | None: ...
    def applied(self) -> None: ...
    def into_owned(self) -> ScanRows: ...
class CallsignRow:
    def __init__(self, holder: DecodedRecord, accepted: bool, corrections: int | None) -> None: ...
    holder: DecodedRecord
    accepted: bool
    corrections: int | None
class CallsignRows:
    def __init__(self, source: bytes, locale: Locale) -> None: ...
    def binding(self, call: Callable[[Binding], T]) -> T: ...
    def next_with(self, default: DecodedRecord, native: Callable[[bytes, Bytes], int]) -> CallsignRow | None: ...
    def into_owned(self) -> CallsignRows: ...
def from_context(context: int) -> Kind: ...
def memory_default(kind: Kind, position: int | None, frequency: int, generation: bytes, ranges: Ranges, system_langid: int | None) -> DecodedRecord: ...
def import_memory(image: Icf, source: bytes, kind: Kind, group: int | None, selection: Selection | None, options: MemoryOptions) -> MemoryImport: ...
def import_user_edge(image: Icf, source: bytes, selection: Selection, whole: bool, locale: Locale) -> Import: ...
def import_scan(image: Icf, source: bytes, selection: Selection, whole: bool, locale: Locale, defaults: Icf | None) -> Import: ...
def import_callsign(image: Icf, source: bytes, selection: Selection | None, locale: Locale, defaults: Icf) -> Import: ...
def export_user_edge(image: Icf, selection: Selection, locale: Locale) -> Export: ...
def export_scan(image: Icf, selection: Selection, locale: Locale) -> Export: ...
def export_callsign(image: Icf, selection: Selection | None, locale: Locale) -> Export: ...
def export_memory(image: Icf, kind: Kind, group: int | None, selection: Selection | None, locale: Locale) -> Export: ...
def export_history(image: Icf, kind: int, selection: Selection | None, locale: Locale, defaults: DefaultContext) -> Export: ...
def export_receive_history(image: Icf, selection: Selection | None, locale: Locale, datetime: Context) -> Export: ...
def export_receive_history_with_date(image: Icf, selection: Selection | None, locale: Locale, datetime: Context, native: Callable[[DateToken], bytes]) -> Export: ...
