from collections.abc import Callable
from typing import TypeVar
from .. import MutableBytes
from .datetime import Date, Time, Context
from .number import CoordinateDialog, CoordinateEvent

T = TypeVar('T')
class Clock:
    def __init__(self, year: int, month: int, day: int, hour: int, minute: int, second: int, millisecond: int) -> None: ...
    def datetime(self) -> tuple[Date, Time]: ...
    year: int
    month: int
    day: int
    hour: int
    minute: int
    second: int
    millisecond: int
class Runtime:
    def __init__(self, locale: Context, time_format: bytes, date_order: int, clock: Clock | None) -> None: ...
    locale: Context
    time_format: bytes
    date_order: int
    clock: Clock | None
    def into_owned(self) -> Runtime: ...
OwnedRuntime = Runtime
class DateDialog:
    def __init__(self, editor: CoordinateDialog, enabled: bool) -> None: ...
    @staticmethod
    def new(raw: bytes, mode_value: int, offset: int, runtime: Runtime, first: int | None) -> DateDialog: ...
    def replace_masked(self, source: bytes, runtime: Runtime) -> None: ...
    def valid(self, runtime: Runtime) -> bool: ...
    def event(self, event: CoordinateEvent, runtime: Runtime) -> bytes | None: ...
    def apply_event(self, raw: MutableBytes, offset: int, event: CoordinateEvent, runtime: Runtime, effect: Effect) -> bool: ...
    enabled: bool
    editor: CoordinateDialog
    def with_editor(self, callback: Callable[[CoordinateDialog], T]) -> T: ...
class Effect:
    def __init__(self, changed: bool, state_out: int | None, display: bytes, selection: tuple[int, int], dialog: DateDialog | None) -> None: ...
    @staticmethod
    def default() -> Effect: ...
    changed: bool
    state_out: int | None
    display: bytes
    selection: tuple[int, int]
    dialog: DateDialog | None
    def with_dialog(self, callback: Callable[[DateDialog], T]) -> T | None: ...
class Input:
    class Display(Input):
        def __init__(self) -> None: ...
    class Inline(Input):
        def __init__(self) -> None: ...
    class Cancel(Input):
        def __init__(self) -> None: ...
    class Begin(Input):
        def __init__(self, first: int | None) -> None: ...
        @property
        def first(self) -> int | None: ...
    class Text(Input):
        def __init__(self, bytes: bytes) -> None: ...
        @property
        def bytes(self) -> bytes: ...
def format(raw: bytes, mode_value: int, offset: int, edit: bool, runtime: Runtime) -> bytes: ...
def phase2(raw: MutableBytes, mode_value: int, offset: int, source: bytes, runtime: Runtime) -> None: ...
def input(raw: MutableBytes, mode_value: int, offset: int, input: Input, runtime: Runtime, effect: Effect) -> None: ...
def edit_masked(raw: MutableBytes, mode_value: int, offset: int, text: bytes, runtime: Runtime, effect: Effect) -> None: ...
