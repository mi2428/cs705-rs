from collections.abc import Callable, Iterable
from typing import TypeVar
from .. import MutableBytes

T = TypeVar('T')

class Date:
    def __init__(self, year: int, month: int, day: int) -> None: ...
    year: int
    month: int
    day: int
class Time:
    def __init__(self, hour: int, minute: int, second: int, millisecond: int) -> None: ...
    hour: int
    minute: int
    second: int
    millisecond: int
class Era:
    def __init__(self, name: bytes | None, offset: int) -> None: ...
    name: bytes | None
    offset: int
    def into_owned(self) -> Era: ...
OwnedEra = Era
class Context:
    def __init__(self, short_date: bytes, date_separator: int, time_separator: int, decimal_separator: int, am: bytes, pm: bytes, current_year: int, two_digit_window: int, primary_language: int, eras: Iterable[Era]) -> None: ...
    short_date: bytes
    date_separator: int
    time_separator: int
    decimal_separator: int
    am: bytes
    pm: bytes
    current_year: int
    two_digit_window: int
    primary_language: int
    @property
    def eras(self) -> tuple[Era, ...]: ...
    @eras.setter
    def eras(self, value: Iterable[Era]) -> None: ...
    def into_owned(self) -> Context: ...
    def with_context(self, call: Callable[[Context], T]) -> T: ...
OwnedContext = Context
class DateToken:
    def __init__(self, date: Date, letter: int, count: int) -> None: ...
    date: Date
    letter: int
    count: int
def valid_date(date: Date) -> bool: ...
def valid_time(time: Time) -> bool: ...
def parse_date(source: bytes, context: Context) -> Date: ...
def parse_time(source: bytes, context: Context) -> Time: ...
def parse_date_with(source: bytes, context: Context, equal: Callable[[bytes, bytes], bool]) -> Date: ...
def parse_time_with(source: bytes, context: Context, equal: Callable[[bytes, bytes], bool]) -> Time: ...
def format_date(date: Date, format: bytes, context: Context, native: Callable[[DateToken], bytes]) -> bytes: ...
def shift_minutes(date: Date, time: Time, minutes: int) -> tuple[Date, Time]: ...
def decode_bcd(byte: int) -> int: ...
def encode_bcd(byte: int) -> int: ...
def decode_raw(raw: bytes) -> tuple[Date, Time]: ...
def import_raw(raw: MutableBytes, date: bytes | None, time: bytes | None, context: Context) -> None: ...
def effective_offset(minutes: int) -> int: ...
def finalize_gps_raw(raw: MutableBytes, minutes: int) -> bool: ...
def fixed_time(time: Time, separator: int) -> bytes: ...
def fixed_time_separators(time: Time, separators: bytes) -> bytes: ...
def gps_date(raw: bytes, offset: int, context: Context, failed_time: Time, native: Callable[[DateToken], bytes]) -> bytes: ...
def gps_time(raw: bytes, offset: int, context: Context, invalid_format_time: Time) -> bytes: ...
def timestamp(raw: bytes, offset: int, separators: bytes) -> bytes: ...
