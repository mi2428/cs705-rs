from collections.abc import Callable
from ..payload import Request
from ..datetime import Date, Time

class Context:
    def __init__(self, date_order: int | None, gui_language: int | None, system_langid: int | None, time_separators: bytes | None) -> None: ...
    date_order: int | None
    gui_language: int | None
    system_langid: int | None
    time_separators: bytes | None
def display_text(logical: bytes, context: Context) -> bytes: ...
def date_mask(order: int) -> bytes: ...
def format(request: Request, context: Context, clock: Callable[[], tuple[Date, Time]]) -> bytes: ...
def format_field(key: int, source: bytes, current: bytes, context: Context, source_pe: bytes | None, resource: Callable[[bytes, int], bytes]) -> bytes: ...
